---
import Base from '../layouts/Base.astro';
import HeroFrame from '../components/HeroFrame.astro';
import PaperCard from '../components/PaperCard.astro';
import Photo from '../components/Photo.astro';
import Countdown from '../components/Countdown.astro';
import FloralSection from '../components/FloralSection.astro';
import SectionHeading from '../components/SectionHeading.astro';
import Divider from '../components/Divider.astro';
import { photo } from '../lib/photos';
import { withBase } from '../lib/url';
import { guestLinks, site } from '../config';

const cards = [
  { href: '/our-story/', kicker: 'Our story', title: 'The question', photo: photo('20') },
  { href: '/travel/', kicker: 'Travel', title: 'Getting to Athens', photo: photo('garden-conservatory') },
  { href: '/registry/', kicker: 'Registry', title: 'Gifts & giving', photo: photo('garden-redbud') },
];
---

<Base>
  <FloralSection class="hero" label="Save the date">
    <div class="container hero__grid">
      <div class="hero__art">
        <HeroFrame photo={photo('35')} />
      </div>

      <div class="hero__text">
        <p class="hero__eyebrow t-caps">Save the date</p>
        <h1 class="hero__names t-script">
          <span>Ally</span>
          <span class="hero__amp">&amp;</span>
          <span>Mark</span>
        </h1>
        <p class="hero__date t-caps">{site.dateKicker}</p>
        <Divider class="hero__divider" />
        <p class="hero__venue t-italic">{site.venue}<br />{site.city}</p>
        <p class="hero__count"><Countdown /></p>
        <p class="hero__note t-italic">formal invitation to follow</p>
      </div>
    </div>
  </FloralSection>

  <FloralSection class="explore" label="Explore">
    <div class="container cards">
      {
        cards.map((c) => (
          <PaperCard sprigs="none" width="fill" as="article" class="card">
            <div class="card__photo">
              <Photo photo={c.photo} sizes="(min-width: 64rem) 20rem, (min-width: 40rem) 42vw, 80vw" widths={[480, 800, 1200]} />
            </div>
            <p class="cc-kicker">{c.kicker}</p>
            <h2 class="card__title t-script">
              <a class="card__link" href={withBase(c.href)}>
                {c.title}
              </a>
            </h2>
          </PaperCard>
        ))
      }
    </div>
  </FloralSection>

  <FloralSection class="join" label="Join in" flora="small" corners="bottom">
    <SectionHeading level={2} size="section" title="Join in" />
    <div class="join__links">
      {
        guestLinks.map((l) => (
          <a class="btn" href={withBase(l.href)}>
            {l.label}
          </a>
        ))
      }
    </div>
  </FloralSection>
</Base>

<style>
  /* ---------- hero: set like the face of an invitation ---------- */
  .hero {
    --room-pad: clamp(1.25rem, 3vw, 2.5rem) clamp(2.5rem, 6vw, 4rem);
  }
  .hero__grid {
    display: grid;
    gap: clamp(1.25rem, 3vw, 2.5rem);
    align-items: center;
  }
  .hero__art {
    width: min(100%, 38rem);
    margin-inline: auto;
    /* the frame's drawing ends above its box: pull the text up under it */
    margin-bottom: -1.75rem;
  }
  .hero__text {
    display: grid;
    justify-items: center;
    gap: 0.55rem;
    text-align: center;
  }
  .hero__eyebrow {
    font-size: clamp(0.92rem, 0.85rem + 0.3vw, 1.08rem);
    letter-spacing: 0.42em;
    margin-right: -0.42em; /* letter-spacing trails the last letter */
  }
  .hero__names {
    display: grid;
    justify-items: center;
    padding: 0.1em 0.3em 0.05em;
    font-size: clamp(5.6rem, 3.4rem + 8vw, 10rem);
    line-height: 0.92;
  }
  .hero__amp {
    font-size: 0.62em;
    line-height: 0.9;
  }
  .hero__date {
    margin-top: 0.6rem;
    font-size: clamp(1rem, 0.88rem + 0.45vw, 1.24rem);
    letter-spacing: 0.3em;
    margin-right: -0.3em;
  }
  .hero__text :global(.hero__divider) {
    width: min(15rem, 70%);
    margin-block: 0.1rem;
  }
  .hero__venue {
    font-size: clamp(1.2rem, 1.08rem + 0.45vw, 1.45rem);
    line-height: 1.4;
  }
  .hero__count {
    margin-top: 0.8rem;
    padding: 0.4rem 1.3rem 0.45rem;
    border-block: 1px solid var(--rule);
    font-family: var(--font-caps);
    font-weight: 600;
    font-size: 0.95rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    font-variant-numeric: lining-nums;
    color: var(--heading);
  }
  .hero__count :global(strong) {
    font-weight: 600;
    font-size: 1.35em;
    letter-spacing: 0.08em;
  }
  .hero__note {
    margin-top: 0.2rem;
    font-size: 1.1rem;
  }
  @media (min-width: 64rem) {
    .hero__grid {
      grid-template-columns: 1.1fr 1fr;
    }
    .hero__art {
      order: 2;
      margin-bottom: 0;
    }
  }

  /* ---------- the three cards ---------- */
  .explore {
    --room-pad: clamp(3.5rem, 7vw, 5rem);
  }
  .cards {
    display: grid;
    gap: clamp(2rem, 4vw, 2.6rem);
    grid-template-columns: repeat(auto-fit, minmax(16.5rem, 1fr));
    max-width: 64rem;
  }
  .cards :global(.card .paper-card__body) {
    display: grid;
    justify-items: center;
    gap: 0.2rem;
    padding: 1.4rem 1.4rem 1.3rem;
    text-align: center;
  }
  .card__photo {
    width: 100%;
    aspect-ratio: 0.86;
    margin-bottom: 1.1rem;
    overflow: hidden;
    border: 1px solid var(--ink);
    border-radius: 50% 50% 0 0 / 36% 36% 0 0;
    outline: 1px solid var(--rule);
    outline-offset: 4px;
  }
  .card__photo :global(picture),
  .card__photo :global(img) {
    width: 100%;
    height: 100%;
  }
  .card__photo :global(img) {
    object-fit: cover;
    object-position: var(--focus);
    filter: var(--photo-tone);
  }
  .card__title {
    font-size: clamp(2.5rem, 2.2rem + 1vw, 2.9rem);
    line-height: 1.1;
  }
  .card__link {
    color: inherit;
    text-decoration: none;
  }
  .card__link::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 3;
  }
  .card__link:focus-visible {
    outline: none;
  }
  .cards :global(.card:has(.card__link:focus-visible)) {
    outline: 2px solid var(--heading);
    outline-offset: 6px;
  }
  .cards :global(.card:hover) {
    background: var(--paper-2);
  }
  .cards :global(.card:hover .card__title) {
    color: var(--heading);
  }

  /* ---------- join in ---------- */
  .join {
    --room-pad: clamp(3rem, 7vw, 4.5rem) clamp(4rem, 8vw, 5.5rem);
  }
  .join__links {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 1.2rem 1.6rem;
    margin-top: 1.6rem;
    padding-inline: var(--gutter);
  }
  .join__links .btn {
    min-width: 15rem;
  }
</style>
