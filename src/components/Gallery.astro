---
// Masonry photo gallery with a PhotoSwipe lightbox (links work without JS too).
import { getImage } from 'astro:assets';
import Photo from './Photo.astro';
import type { Photo as PhotoT } from '../lib/photos';

interface Props {
  photos: PhotoT[];
  class?: string;
}
const { photos, class: cls } = Astro.props;

const items = await Promise.all(
  photos.map(async (p) => {
    const w = Math.min(2000, p.src.width);
    const large = await getImage({ src: p.src, width: w, format: 'webp', quality: 80 });
    return { p, href: large.src, w, h: Math.round((w * p.src.height) / p.src.width) };
  }),
);
---

<div class:list={['gallery', cls]} data-gallery>
  {
    items.map(({ p, href, w, h }) => (
      <a class="gallery__item reveal" href={href} data-pswp-width={w} data-pswp-height={h}>
        <Photo photo={p} sizes="(min-width: 64rem) 23rem, (min-width: 40rem) 46vw, 92vw" widths={[480, 800, 1200]} />
      </a>
    ))
  }
</div>

<script>
  import PhotoSwipeLightbox from 'photoswipe/lightbox';
  import 'photoswipe/style.css';

  const lightbox = new PhotoSwipeLightbox({
    gallery: '[data-gallery]',
    children: 'a',
    pswpModule: () => import('photoswipe'),
    bgOpacity: 0.95,
    showHideAnimationType: 'fade',
  });
  lightbox.init();
</script>

<style>
  .gallery {
    columns: 3 18rem;
    column-gap: 1rem;
  }
  .gallery__item {
    display: block;
    margin-bottom: 1rem;
    break-inside: avoid;
    border-radius: var(--radius);
    overflow: hidden;
    box-shadow: var(--shadow-soft);
    outline-offset: 3px;
  }
  .gallery__item :global(img) {
    width: 100%;
    transition: transform 500ms var(--ease);
  }
  .gallery__item:hover :global(img) {
    transform: scale(1.025);
  }
  :global(.pswp) {
    --pswp-bg: #0f1e17;
  }
</style>
