---
// A dark conservatory "room": evergreen trellis wallpaper lit by candle glow,
// a double gilt border with corner scrolls, twinkling fireflies and, optionally,
// native plants spilling in from all four corners.
import { trellisTile } from '../lib/natives';
import Flora from './Flora.astro';

type Firefly = [x: number, y: number, seconds: number, delay: number];

interface Props {
  class?: string;
  /** aria-label for the section */
  label?: string;
  /** where the candle glow sits, as a CSS position */
  glow?: string;
  fireflies?: Firefly[];
  /** plants in the corners: 'full' (big swags, beds and side vines) or 'small' */
  flora?: 'full' | 'small' | false;
  style?: string;
}

const FLIES: Firefly[] = [
  [9, 22, 4.2, 0.4],
  [91, 16, 5, 1.6],
  [14, 62, 4.6, 2.2],
  [88, 48, 3.8, 0.9],
  [24, 8, 5.2, 1.2],
  [78, 86, 4.4, 2.8],
  [6, 90, 5.6, 0.2],
  [95, 74, 4.9, 1.9],
];
const { class: cls, label, glow = '50% 30%', fireflies = FLIES, flora = false, style = '', ...rest } = Astro.props;
const wallpaper = `url("data:image/svg+xml,${encodeURIComponent(trellisTile())}")`;
---

<section
  class:list={['room', cls, flora && `room--flora-${flora}`]}
  style={`--wallpaper:${wallpaper};--glow-at:${glow};${style}`}
  aria-label={label}
  {...rest}
>
  <div class="room__border" aria-hidden="true">
    {
      ['tl', 'tr', 'bl', 'br'].map((c) => (
        <svg class={`room__corner room__corner--${c}`} viewBox="0 0 64 64" focusable="false">
          <g fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round">
            <path d="M4,44 C4,20 20,4 44,4" />
            <path d="M11,44 C11,25 25,11 44,11" opacity=".55" />
            <path d="M44,4 C53,4 57,11 52,15 C48.5,18 44,14.5 46.5,11.5" />
            <path d="M4,44 C4,53 11,57 15,52 C18,48.5 14.5,44 11.5,46.5" />
          </g>
          <path d="M17,17 C23,9 34,7 41,9 C37,16 27,20 17,17Z" fill="currentColor" opacity=".85" />
          <path d="M17,17 C9,23 7,34 9,41 C16,37 20,27 17,17Z" fill="currentColor" opacity=".6" />
          <circle cx="15" cy="15" r="3" fill="currentColor" />
        </svg>
      ))
    }
  </div>
  {
    flora && (
      <div class="room__flora" aria-hidden="true">
        {flora === 'full' && <Flora name="vine" class="room__plant room__vine room__vine--l" />}
        {flora === 'full' && <Flora name="vine" mirror class="room__plant room__vine room__vine--r" />}
        <Flora name="swag" eager={flora === 'full'} class="room__plant room__plant--tl" />
        <Flora name="swag" eager={flora === 'full'} mirror class="room__plant room__plant--tr" />
        <Flora name="bed" class="room__plant room__plant--bl" />
        <Flora name="bed" mirror class="room__plant room__plant--br" />
      </div>
    )
  }
  {
    fireflies.length > 0 && (
      <div class="room__fireflies" aria-hidden="true">
        {fireflies.map(([x, y, d, delay]) => (
          <span style={`left:${x}%;top:${y}%;--d:${d}s;--delay:${delay}s`} />
        ))}
      </div>
    )
  }
  <div class="room__inner">
    <slot />
  </div>
</section>

<style>
  .room {
    position: relative;
    overflow: hidden;
    padding-block: var(--room-pad, clamp(2.5rem, 6vw, 4.5rem));
    background-color: #18301f;
    background-image:
      radial-gradient(circle at var(--glow-at), rgb(224 168 79 / 0.3), transparent 55%),
      radial-gradient(ellipse at 50% 45%, transparent 50%, rgb(5 12 8 / 0.6)),
      var(--wallpaper);
    background-size: auto, auto, 96px 128px;
    color: #f3e8cf;
  }
  .room__border {
    position: absolute;
    inset: clamp(8px, 1.4vw, 16px);
    border: 1.5px solid rgb(201 160 70 / 0.8);
    outline: 1px solid rgb(201 160 70 / 0.45);
    outline-offset: -7px;
    pointer-events: none;
    z-index: 1;
  }
  .room__corner {
    position: absolute;
    width: clamp(40px, 5vw, 64px);
    color: #d4a548;
  }
  .room__corner--tl {
    top: -2px;
    left: -2px;
  }
  .room__corner--tr {
    top: -2px;
    right: -2px;
    transform: scaleX(-1);
  }
  .room__corner--bl {
    bottom: -2px;
    left: -2px;
    transform: scaleY(-1);
  }
  .room__corner--br {
    bottom: -2px;
    right: -2px;
    transform: scale(-1, -1);
  }

  /* plants in the corners */
  .room__flora {
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 1;
  }
  .room :global(.room__plant) {
    --flora-w: var(--plant-w);
  }
  .room--flora-full {
    --plant-w: clamp(178px, 30vw, 440px);
  }
  .room--flora-small {
    --plant-w: clamp(110px, 19vw, 280px);
  }
  /* climbing vines on the side walls of tall rooms (wide screens only) */
  .room :global(.room__vine) {
    display: none;
    top: 50%;
    --flora-w: clamp(130px, 12vw, 200px);
    translate: 0 -50%;
  }
  .room :global(.room__vine--l) {
    left: clamp(-10px, 0.6vw, 16px);
  }
  .room :global(.room__vine--r) {
    right: clamp(-10px, 0.6vw, 16px);
  }
  @media (min-width: 64rem) {
    .room :global(.room__vine) {
      display: block;
    }
  }
  .room :global(.room__plant--tl) {
    top: 0;
    left: 0;
  }
  .room :global(.room__plant--tr) {
    top: 0;
    right: 0;
  }
  .room :global(.room__plant--bl) {
    bottom: 0;
    left: 0;
  }
  .room :global(.room__plant--br) {
    bottom: 0;
    right: 0;
  }

  /* fireflies */
  .room__fireflies span {
    position: absolute;
    z-index: 1;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: radial-gradient(circle, #fff4c2 0%, #f2c45a 35%, rgb(242 196 90 / 0) 70%);
    box-shadow: 0 0 12px 4px rgb(242 196 90 / 0.35);
    opacity: 0.85;
  }
  @media (prefers-reduced-motion: no-preference) {
    .room__fireflies span {
      animation: twinkle var(--d, 4s) ease-in-out var(--delay, 0s) infinite alternate;
    }
    @keyframes twinkle {
      from {
        opacity: 0.15;
        translate: 0 0;
      }
      to {
        opacity: 0.95;
        translate: 6px -10px;
      }
    }
  }

  .room__inner {
    position: relative;
    z-index: 2;
  }
</style>
