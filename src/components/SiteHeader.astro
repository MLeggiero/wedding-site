---
// The site header: the names in script and the pages in spaced capitals over
// a fine rule. On phones the menu opens as an engraved card.
import { nav } from '../config';
import { withBase, isCurrent } from '../lib/url';
import Flora from './Flora.astro';

const path = Astro.url.pathname;
---

<header class="site-header">
  <div class="container site-header__inner">
    <a class="brand t-script" href={withBase('/')}>Ally &amp; Mark</a>

    <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="site-nav">
      <span class="menu-toggle__label">Menu</span>
      <span class="menu-toggle__icon" aria-hidden="true"><span></span></span>
    </button>

    <nav id="site-nav" class="site-nav" aria-label="Main">
      <div class="site-nav__flora" aria-hidden="true">
        <Flora name="corner" class="site-nav__plant site-nav__plant--tl" />
        <Flora name="corner-low" mirror class="site-nav__plant site-nav__plant--br" />
      </div>
      <ul>
        {
          nav.map((item) => (
            <li>
              <a href={withBase(item.href)} aria-current={isCurrent(item.href, path) ? 'page' : undefined}>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>

<script>
  const btn = document.querySelector<HTMLButtonElement>('.menu-toggle');
  const nav = document.getElementById('site-nav');
  const setOpen = (open: boolean) => {
    btn?.setAttribute('aria-expanded', String(open));
    document.documentElement.classList.toggle('menu-open', open);
  };
  btn?.addEventListener('click', () => setOpen(btn.getAttribute('aria-expanded') !== 'true'));
  nav?.addEventListener('click', (e) => {
    if ((e.target as HTMLElement).closest('a')) setOpen(false);
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && document.documentElement.classList.contains('menu-open')) {
      setOpen(false);
      btn?.focus();
    }
  });
</script>

<style>
  .site-header {
    position: relative;
    z-index: 20;
    padding-block: 0.5rem 0.55rem;
    border-bottom: 1px solid var(--rule);
    background: var(--paper);
  }
  .site-header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }
  .brand {
    position: relative;
    z-index: 31;
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    padding-inline: 0.1em;
    font-size: 2.3rem;
    line-height: 1;
    color: var(--ink);
    text-decoration: none;
  }
  .brand:hover {
    color: var(--heading);
  }

  .site-nav ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    gap: clamp(0.9rem, 2vw, 2rem);
  }
  .site-nav a {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    font-family: var(--font-caps);
    font-weight: 600;
    font-size: 0.86rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--heading);
    text-decoration: none;
    border-bottom: 1px solid transparent;
  }
  .site-nav a:hover {
    border-bottom-color: var(--rule);
  }
  .site-nav a[aria-current='page'] {
    border-bottom-color: var(--ink);
  }
  .menu-toggle,
  .site-nav__flora {
    display: none;
  }

  @media (max-width: 63.99rem) {
    .menu-toggle {
      position: relative;
      z-index: 31;
      display: inline-flex;
      align-items: center;
      gap: 0.6rem;
      min-height: 2.75rem;
      padding: 0.3rem 0.9rem;
      border: 1px solid var(--ink);
      border-radius: 2px;
      background: var(--paper);
      color: var(--heading);
      font-family: var(--font-caps);
      font-weight: 600;
      font-size: 0.82rem;
      letter-spacing: 0.22em;
      text-transform: uppercase;
      cursor: pointer;
    }
    .menu-toggle__icon,
    .menu-toggle__icon span,
    .menu-toggle__icon::before,
    .menu-toggle__icon::after {
      display: block;
      width: 1.05rem;
      height: 1px;
      background: currentColor;
      transition:
        transform 200ms var(--ease),
        opacity 200ms var(--ease);
    }
    .menu-toggle__icon {
      position: relative;
      background: none;
    }
    .menu-toggle__icon::before,
    .menu-toggle__icon::after {
      content: '';
      position: absolute;
      left: 0;
    }
    .menu-toggle__icon::before {
      top: -5px;
    }
    .menu-toggle__icon::after {
      top: 5px;
    }
    :global(.menu-open) .menu-toggle__icon span {
      opacity: 0;
    }
    :global(.menu-open) .menu-toggle__icon::before {
      transform: translateY(5px) rotate(45deg);
    }
    :global(.menu-open) .menu-toggle__icon::after {
      transform: translateY(-5px) rotate(-45deg);
    }

    .site-nav {
      position: fixed;
      inset: 0;
      z-index: 30;
      display: grid;
      place-items: center;
      padding: 6rem var(--gutter) 4rem;
      overflow: hidden;
      background: var(--paper);
      opacity: 0;
      visibility: hidden;
      transition:
        opacity 220ms var(--ease),
        visibility 0s 220ms;
    }
    .site-nav::before {
      content: '';
      position: absolute;
      inset: 4.6rem 0.75rem 0.75rem;
      border: 1px solid var(--ink);
      outline: 1px solid var(--rule);
      outline-offset: -6px;
      pointer-events: none;
    }
    :global(.menu-open) .site-nav {
      opacity: 1;
      visibility: visible;
      transition: opacity 220ms var(--ease);
    }
    :global(.menu-open) {
      overflow: hidden;
    }
    .site-nav__flora {
      display: block;
      position: absolute;
      inset: 0;
      pointer-events: none;
    }
    .site-nav :global(.site-nav__plant) {
      --flora-w: clamp(170px, 46vw, 300px);
    }
    .site-nav :global(.site-nav__plant--tl) {
      top: 4.6rem;
      left: 0;
    }
    .site-nav :global(.site-nav__plant--br) {
      bottom: 0;
      right: 0;
    }
    .site-nav ul {
      position: relative;
      flex-direction: column;
      align-items: center;
      gap: 0.35rem;
      padding: 1rem 2rem;
      background: var(--paper);
    }
    .site-nav a {
      font-size: 1.1rem;
      min-height: 3rem;
    }
  }
</style>
