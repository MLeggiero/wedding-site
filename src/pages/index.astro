---
import Base from '../layouts/Base.astro';
import ArchFrame from '../components/ArchFrame.astro';
import Foliage from '../components/Foliage.astro';
import Countdown from '../components/Countdown.astro';
import IronworkDivider from '../components/IronworkDivider.astro';
import { photo } from '../lib/photos';
import { withBase } from '../lib/url';
import { site } from '../config';

const cards = [
  {
    href: '/our-story/',
    kicker: 'Our Story',
    title: 'Under the tall trees',
    text: 'How a spring walk turned into a question.',
    cta: 'Read our story',
    photo: photo('13'),
  },
  {
    href: '/travel/',
    kicker: 'Travel',
    title: 'Getting to Athens',
    text: 'How to get here, where to stay and what to do around town.',
    cta: 'Plan your trip',
    photo: photo('59'),
  },
  {
    href: '/registry/',
    kicker: 'Registry',
    title: 'Gifts & giving',
    text: `Our registry opens in ${site.registryOpens}.`,
    cta: 'Take a look',
    photo: photo('61'),
  },
];
---

<Base>
  <section class="hero">
    <div class="hero__glow" aria-hidden="true"></div>
    <div class="container hero__grid">
      <div class="hero__visual">
        <Foliage kind="palm-a" tone="fern" flip class="hero__palm" style="--sway-from:-1deg; --sway-to:1.6deg;" />
        <Foliage kind="ivy-a" class="hero__ivy" style="--sway-duration:9s; --sway-delay:-2s;" />
        <ArchFrame
          photo={photo('55')}
          panes={3}
          priority
          sizes="(min-width: 64rem) 30rem, 88vw"
          alt="Ally and Mark, newly engaged, beneath a flowering tree in full bloom"
          class="hero__arch"
        />
        <Foliage kind="fern-b" class="hero__fern" style="--sway-delay:-4s;" />
        <Foliage kind="monstera-a" tone="fern" class="hero__monstera" style="--sway-duration:8s; --sway-delay:-1s;" />
      </div>

      <div class="hero__text">
        <p class="kicker">Save the date</p>
        <h1 class="hero__names">
          <span>Ally</span>
          <span class="amp">&amp;</span>
          <span>Mark</span>
        </h1>
        <p class="hero__date">{site.dateKicker}</p>
        <p class="hero__venue">{site.venue}<br />{site.city}</p>
        <Countdown />
        <p class="hero__note">Formal invitation to follow</p>
      </div>
    </div>
  </section>

  <section class="section welcome">
    <div class="container prose center reveal">
      <IronworkDivider />
      <h2>We’re getting married under glass</h2>
      <p>
        Next spring we’ll say “I do” in the conservatory at the State Botanical Garden of Georgia, and we would love for
        you to be there. Formal invitations will follow in {site.invitationsSend}.
      </p>
      <p>
        Until then, this little glasshouse is where you’ll find our story, travel tips for Athens and, soon, our
        registry.
      </p>
    </div>
  </section>

  <section class="cards-section" aria-label="Explore">
    <div class="container cards">
      {
        cards.map((c) => (
          <article class="card glass reveal">
            <ArchFrame photo={c.photo} aspect={0.82} bars="frame" sizes="(min-width: 64rem) 20rem, (min-width: 40rem) 42vw, 80vw" />
            <div class="card__body">
              <p class="kicker">{c.kicker}</p>
              <h3>
                <a class="card__link" href={withBase(c.href)}>
                  {c.title}
                </a>
              </h3>
              <p>{c.text}</p>
              <span class="arrow-link" aria-hidden="true">
                {c.cta}
              </span>
            </div>
          </article>
        ))
      }
    </div>
  </section>

  <section class="section guests band-dark">
    <Foliage kind="fern-a" tone="fern" class="guests__fern" style="--sway-delay:-2s;" />
    <div class="container guests__inner reveal">
      <p class="kicker">For invited guests</p>
      <h2>The details live inside the glasshouse</h2>
      <p>
        The schedule, a map of the garden and the RSVP open here when invitations go out in {site.invitationsSend}. Your
        invitation will include the password.
      </p>
      <a class="btn btn--ghost" href={withBase('/details/')}>Details &amp; RSVP</a>
    </div>
  </section>
</Base>

<style>
  /* ---------- hero ---------- */
  .hero {
    position: relative;
    overflow: hidden;
    padding-block: clamp(2rem, 5vw, 4rem) clamp(3rem, 7vw, 5rem);
  }
  .hero__glow {
    position: absolute;
    inset: 0;
    background: radial-gradient(52% 58% at 72% 42%, rgb(220 199 158 / 0.5), transparent 72%);
    pointer-events: none;
  }
  .hero__grid {
    position: relative;
    display: grid;
    gap: clamp(2.5rem, 6vw, 4rem);
    align-items: center;
  }
  .hero__visual {
    position: relative;
    width: min(100%, 27rem);
    margin-inline: auto;
    padding-top: 6%;
  }
  .hero__visual :global(.hero__arch) {
    z-index: 1;
    filter: drop-shadow(0 26px 36px rgb(30 58 43 / 0.25));
  }
  .hero__visual :global(.hero__palm) {
    width: 118%;
    left: 31%;
    top: -9%;
    opacity: 0.92;
  }
  .hero__visual :global(.hero__ivy) {
    width: 17%;
    left: -15%;
    top: 14%;
  }
  .hero__visual :global(.hero__fern) {
    width: 48%;
    left: -25%;
    bottom: -7%;
  }
  .hero__visual :global(.hero__monstera) {
    width: 52%;
    right: -26%;
    bottom: -9%;
  }

  .hero__text {
    display: grid;
    justify-items: center;
    gap: 0.9rem;
    text-align: center;
  }
  .hero__names {
    display: grid;
    justify-items: center;
    font-size: clamp(4rem, 2.6rem + 7vw, 7.4rem);
    font-style: italic;
    font-weight: 400;
    line-height: 0.92;
    letter-spacing: -0.01em;
  }
  .hero__names .amp {
    font-size: 0.55em;
    line-height: 1.1;
  }
  .hero__date {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(1.15rem, 1rem + 0.6vw, 1.45rem);
    letter-spacing: 0.24em;
    text-transform: uppercase;
    font-variant-numeric: lining-nums;
    color: var(--green-900);
  }
  .hero__venue {
    font-family: var(--font-display);
    font-size: 1.35rem;
    line-height: 1.35;
    color: var(--walnut-700);
  }
  .hero__note {
    font-family: var(--font-display);
    font-style: italic;
    font-size: 1.25rem;
    color: var(--walnut-700);
  }

  @media (min-width: 64rem) {
    .hero__grid {
      grid-template-columns: 1.05fr 1fr;
    }
    .hero__visual {
      order: 2;
      width: min(100%, 30rem);
    }
    .hero__text {
      order: 1;
    }
  }

  /* ---------- welcome ---------- */
  .welcome {
    padding-top: clamp(1rem, 4vw, 3rem);
  }
  .welcome .prose {
    display: grid;
    gap: 1.1rem;
    justify-items: center;
  }
  .welcome h2 {
    font-size: var(--step-4);
  }
  .welcome p {
    font-size: 1.2rem;
  }

  /* ---------- cards ---------- */
  .cards-section {
    padding-bottom: clamp(3.5rem, 8vw, 6rem);
  }
  .cards {
    display: grid;
    gap: clamp(1.25rem, 3vw, 2rem);
    grid-template-columns: repeat(auto-fit, minmax(17rem, 1fr));
  }
  .card {
    display: grid;
    gap: 1.1rem;
    padding: 1.1rem 1.1rem 1.5rem;
    transition:
      transform 300ms var(--ease),
      box-shadow 300ms var(--ease);
  }
  .card:hover {
    transform: translateY(-4px);
  }
  .card__body {
    display: grid;
    gap: 0.45rem;
    padding-inline: 0.4rem;
    text-align: center;
  }
  .card h3 {
    font-size: 1.9rem;
  }
  .card__link {
    color: inherit;
    text-decoration: none;
  }
  .card__link::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 3;
    border-radius: var(--radius);
  }
  .card__link:focus-visible {
    outline: none;
  }
  .card__link:focus-visible::after {
    outline: 2px solid var(--brass-500);
    outline-offset: 4px;
  }
  .card .arrow-link {
    color: var(--green-700);
    margin-top: 0.3rem;
  }

  /* ---------- invited guests ---------- */
  .guests {
    position: relative;
    overflow: hidden;
    margin-bottom: calc(-1 * clamp(3rem, 8vw, 6rem));
  }
  .guests__inner {
    position: relative;
    z-index: 3;
    display: grid;
    justify-items: center;
    gap: 1rem;
    max-width: 40rem;
    text-align: center;
  }
  .guests h2 {
    font-size: var(--step-4);
  }
  .guests p {
    color: var(--glass-100);
  }
  .guests :global(.guests__fern) {
    width: clamp(9rem, 22vw, 17rem);
    left: -3rem;
    bottom: -2rem;
    opacity: 0.45;
  }
</style>
