---
import Base from '../layouts/Base.astro';
import IronworkDivider from '../components/IronworkDivider.astro';
import { withBase } from '../lib/url';
---

<Base title="Off the path">
  <section class="container lost">
    <p class="kicker">Page not found</p>
    <h1>You’ve wandered off the path</h1>
    <IronworkDivider />
    <p class="lead">This corner of the garden hasn’t been planted yet.</p>
    <a class="btn" href={withBase('/')}>Back to the garden</a>
  </section>
</Base>

<style>
  .lost {
    display: grid;
    justify-items: center;
    gap: 1rem;
    padding-block: clamp(4rem, 10vw, 7rem) 2rem;
    text-align: center;
  }
  .lost h1 {
    font-size: var(--step-4);
  }
</style>
