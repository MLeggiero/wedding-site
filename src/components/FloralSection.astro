---
// A section of the page framed by engraved plants at its corners, like the
// border of an invitation (lib/flora.ts): clusters hang from the line at the
// top and rise from the line at the foot. 'full' and 'small' set their size.
// The section keeps clear space at its foot so the rising plants never slip
// behind cards, buttons or text. Mushrooms come up at the foot of the rising
// clusters (a different mix each side), and a butterfly or moth can rest on
// the plants (lib/woodland.ts).
import Flora from './Flora.astro';
import Butterfly from './Butterfly.astro';
import { artView, type ArtName } from '../lib/art';
import type { ButterflyKind } from '../lib/insects';

type Floor = Extract<ArtName, `floor-${string}`>;
type Perch = 'leaf' | 'vine' | 'maypop';

interface Props {
  class?: string;
  /** aria-label for the section */
  label?: string;
  flora?: 'full' | 'small' | false;
  /** which corners carry plants: hanging from the top, rising from the bottom, or both */
  corners?: 'both' | 'top' | 'bottom';
  /** what comes up at the foot of the left and right clusters */
  floor?: [Floor, Floor];
  /**
   * A butterfly or moth resting on the plants: at the tip of the lowest dogwood
   * leaf on the right ('leaf', the default), at the end of the jessamine on the
   * left ('vine'), or on the maypop at the foot ('maypop', the default when the
   * top has no plants). Spread ('open') or at rest with its wings closed.
   */
  butterfly?: { kind: ButterflyKind; pose?: 'open' | 'closed'; perch?: Perch; tilt?: [number, number] };
  style?: string;
}
const { class: cls, label, flora = false, corners = 'both', floor = ['floor-morels', 'floor-log'], butterfly, style } = Astro.props;
const top = corners !== 'bottom';
const bottom = corners !== 'top';
// where it rests, in the cluster's own units. Spread, it sits at the leaf tip or the end of the vine
// with its wings over open paper; with its wings closed it hangs under the leaf, stands on the vine's
// end, or stands on the maypop's petals to drink.
const perches: Record<Perch, { art: 'corner' | 'corner-low'; open: object; closed: object }> = {
  leaf: { art: 'corner', open: { at: [398, 258], size: 150, rot: -28 }, closed: { at: [386, 252], size: 140, rot: 172 } },
  vine: { art: 'corner', open: { at: [512, 96], size: 140, rot: 58 }, closed: { at: [505, 80], size: 140, rot: -8 } },
  maypop: { art: 'corner-low', open: { at: [392, 296], size: 140, rot: 24 }, closed: { at: [345, 316], size: 140, rot: 0 } },
};
const perch = butterfly ? (butterfly.perch ?? (top ? 'leaf' : 'maypop')) : null;
const bf = butterfly &&
  perch && {
    kind: butterfly.kind,
    pose: butterfly.pose,
    tilt: butterfly.tilt,
    view: artView(perches[perch].art),
    eager: flora === 'full' && perch !== 'maypop',
    ...(perches[perch][butterfly.pose ?? 'open'] as { at: [number, number]; size: number; rot: number }),
  };
---

<section
  class:list={['room', cls, flora && `room--${flora}`, flora && top && 'room--hanging', flora && bottom && 'room--rising']}
  aria-label={label}
  style={style}
>
  {
    flora && (
      <div class="room__flora" aria-hidden="true">
        {top && (
          <Flora name="corner" eager={flora === 'full'} class="room__plant room__plant--tl">
            {bf && perch === 'vine' && <Butterfly {...bf} />}
          </Flora>
        )}
        {top && (
          <Flora name="corner" eager={flora === 'full'} mirror class="room__plant room__plant--tr">
            {bf && perch === 'leaf' && <Butterfly {...bf} />}
          </Flora>
        )}
        {bottom && <Flora name="corner-low" extra={[floor[0]]} class="room__plant room__plant--bl" />}
        {bottom && (
          <Flora name="corner-low" extra={[floor[1]]} mirror class="room__plant room__plant--br">
            {bf && perch === 'maypop' && <Butterfly {...bf} />}
          </Flora>
        )}
      </div>
    )
  }
  <slot name="decor" />
  <div class="room__inner">
    <slot />
  </div>
</section>

<style>
  .room {
    position: relative;
    overflow: hidden;
    padding-block: var(--room-pad, clamp(2.5rem, 6vw, 4.5rem));
  }
  .room__flora {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }
  /* between two sections, a hairline that the plants tuck behind (it hides
     where the corner drawings meet the edge of their section) */
  .room + .room::before {
    content: '';
    position: absolute;
    z-index: 1;
    inset: 0 0 auto;
    border-top: 1px solid var(--rule);
  }
  .room--full {
    --plant-w: clamp(128px, 27vw, 400px);
  }
  .room--small {
    --plant-w: clamp(124px, 17vw, 250px);
  }
  .room :global(.room__plant) {
    --flora-w: var(--plant-w);
  }
  .room :global(.room__plant--tl) {
    top: 0;
    left: 0;
  }
  .room :global(.room__plant--tr) {
    top: 0;
    right: 0;
  }
  .room :global(.room__plant--bl) {
    bottom: 0;
    left: 0;
  }
  .room :global(.room__plant--br) {
    bottom: 0;
    right: 0;
  }
  /* on small screens a butterfly keeps a size you can make out */
  .room :global(.room__plant) {
    --bf-min: 3.5rem;
  }
  .room__inner {
    position: relative;
    z-index: 2;
  }
  /* phones: the hanging clusters span most of the width, so the heading starts below them */
  @media (max-width: 39.99rem) {
    .room--hanging {
      padding-top: calc(var(--plant-w) * 0.66);
    }
  }
  /* clear ground at the foot for the rising clusters (they stand about 0.8 of --plant-w tall) */
  .room--rising .room__inner::after {
    content: '';
    display: block;
    height: calc(var(--plant-w) * 0.62);
  }
</style>
