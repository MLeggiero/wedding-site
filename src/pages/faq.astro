---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import CozyRoom from '../components/CozyRoom.astro';
import RoomHeading from '../components/RoomHeading.astro';
import GiltCard from '../components/GiltCard.astro';
import { inlineMd } from '../lib/inline-md';
import { site } from '../config';

const faqs = (await getCollection('faq')).map((f) => f.data);
---

<Base title="FAQ" description="Questions and answers about Ally & Mark’s wedding.">
  <CozyRoom flora="full" label="Questions and answers">
    <RoomHeading eyebrow="FAQ" title="Questions" lead="The things people ask us most." />
    <GiltCard class="faq-card" as="section">
      <div class="faq-list">
        {
          faqs.map((f, i) => (
            <details class="faq" open={i < 2}>
              <summary>
                <span>{f.question}</span>
                <span class="faq__icon" aria-hidden="true" />
              </summary>
              <div class="faq__answer cc-text" set:html={inlineMd(f.answer)} />
            </details>
          ))
        }
      </div>
      {
        site.contactEmail && (
          <p class="faq-contact cc-text">
            Still wondering? Email us at <a href={`mailto:${site.contactEmail}`}>{site.contactEmail}</a>.
          </p>
        )
      }
    </GiltCard>
  </CozyRoom>
</Base>

<style>
  :global(.faq-card) {
    margin-block: clamp(4.5rem, 10vw, 6rem) clamp(5.5rem, 10vw, 6rem);
  }
  .faq-list {
    border-top: 1px solid rgb(168 130 58 / 0.5);
  }
  .faq {
    border-bottom: 1px solid rgb(168 130 58 / 0.4);
  }
  .faq summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    min-height: 3.2rem;
    padding: 0.85rem 0.2rem;
    cursor: pointer;
    list-style: none;
    font-family: 'Playfair Display Variable', Georgia, serif;
    font-weight: 600;
    font-size: clamp(1.18rem, 1.1rem + 0.35vw, 1.35rem);
    line-height: 1.3;
    color: #18301f;
  }
  .faq summary::-webkit-details-marker {
    display: none;
  }
  .faq summary:hover {
    color: #5e1a29;
  }
  .faq summary:focus-visible {
    outline: 2px solid #7a2637;
    outline-offset: 2px;
  }
  .faq__icon {
    position: relative;
    flex: none;
    width: 1.6rem;
    height: 1.6rem;
    border-radius: 50%;
    box-shadow: inset 0 0 0 1px #a07a35;
  }
  .faq__icon::before,
  .faq__icon::after {
    content: '';
    position: absolute;
    left: 50%;
    top: 50%;
    width: 0.7rem;
    height: 1.5px;
    background: #5e1a29;
    translate: -50% -50%;
    transition: rotate 200ms var(--ease);
  }
  .faq__icon::after {
    rotate: 90deg;
  }
  .faq[open] .faq__icon::after {
    rotate: 0deg;
  }
  .faq__answer {
    padding: 0 0.2rem 1.1rem;
  }
  .faq-contact {
    margin-top: 1.2rem;
    text-align: center;
  }
</style>
