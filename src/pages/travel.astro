---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import FloralSection from '../components/FloralSection.astro';
import SectionHeading from '../components/SectionHeading.astro';
import PaperCard from '../components/PaperCard.astro';
import HeroFrame from '../components/HeroFrame.astro';
import { photo } from '../lib/photos';
import { site } from '../config';

const places = (await getCollection('places')).map((p) => p.data);
const order = ['Wander', 'Saturday', 'Coffee', 'Eat', 'Drink', 'Music', 'Shop'] as const;
const labels: Record<string, string> = {
  Wander: 'Wander',
  Saturday: 'Saturday morning',
  Coffee: 'Coffee',
  Eat: 'Eat',
  Drink: 'Drink',
  Music: 'Music',
  Shop: 'Shop',
};
const groups = order
  .map((category) => ({ category, items: places.filter((p) => p.category === category) }))
  .filter((g) => g.items.length);
const mapsUrl = (query: string) => `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(query)}`;
const tips = [
  { kicker: 'Flying in', title: 'Atlanta (ATL)', text: 'About ninety minutes from Athens by car.' },
  { kicker: 'Where to stay', title: 'Hotel blocks', text: 'Rooms in town, with any discount codes, posted here soon.', soon: `In ${site.registryOpens}` },
  { kicker: 'Weather', title: 'Late-April spring', text: 'Warm days, cool evenings. Bring a layer.' },
];
---

<Base title="Travel" description="How to get to Athens, Georgia for Ally & Mark’s wedding, and what to do while you’re in town.">
  <FloralSection flora="full" label="Travel">
    <SectionHeading eyebrow="travel" title="Getting to Athens" lead="Ninety minutes from Atlanta." />

    <div class="trip container">
      <div class="trip__photo">
        <HeroFrame photo={photo('garden-conservatory')} art="arch" priority sizes="(min-width: 60rem) 26rem, 80vw" />
      </div>
      <PaperCard sprigs="two" width="fill" as="section" class="venue">
        <p class="cc-kicker">The venue</p>
        <h2 class="cc-title">{site.venue}</h2>
        <p class="cc-text venue__address">{site.address}</p>
        <p class="cc-text">Free parking. Downtown is ten minutes away.</p>
        <a class="btn btn--small venue__map" href={site.mapsUrl} target="_blank" rel="noopener">Open in Maps</a>
      </PaperCard>
    </div>

    <div class="tips container">
      {
        tips.map((t) => (
          <PaperCard sprigs="none" width="fill" as="article" class="tip">
            <p class="cc-kicker">{t.kicker}</p>
            <h3 class="cc-title">{t.title}</h3>
            <p class="cc-text">{t.text}</p>
            {t.soon && <p class="tag tip__soon">{t.soon}</p>}
          </PaperCard>
        ))
      }
    </div>

    <SectionHeading level={2} size="section" title="Around Athens" lead="A few favorites." class="guide-head" />
    <div class="guide container">
      {
        groups.map((g) => (
          <PaperCard sprigs="none" width="fill" as="section" class="guide__group">
            <h3 class="cc-kicker guide__cat">{labels[g.category]}</h3>
            <ul class="guide__list">
              {g.items.map((p) => (
                <li class="place">
                  <a class="place__name" href={mapsUrl(p.map ?? `${p.name}, Athens, GA`)} target="_blank" rel="noopener">
                    {p.name}
                    <span class="visually-hidden"> (map)</span>
                  </a>
                  {p.area && <span class="place__area">{p.area}</span>}
                  <p class="place__note">{p.note}</p>
                </li>
              ))}
            </ul>
          </PaperCard>
        ))
      }
    </div>
  </FloralSection>
</Base>

<style>
  .trip {
    display: grid;
    gap: clamp(3rem, 6vw, 4rem);
    align-items: center;
    max-width: 64rem;
    margin-top: clamp(2.5rem, 6vw, 4rem);
  }
  .trip__photo {
    width: min(100%, 28rem);
    margin-inline: auto;
  }
  .trip :global(.venue) {
    width: min(100%, 30rem);
    margin-inline: auto;
  }
  .trip :global(.venue .paper-card__body),
  .tips :global(.tip .paper-card__body) {
    display: grid;
    justify-items: center;
    gap: 0.35rem;
    text-align: center;
  }
  .venue__address {
    font-style: italic;
  }
  .venue__map {
    margin-top: 0.7rem;
  }
  .tips {
    display: grid;
    gap: 2rem;
    max-width: 62rem;
    margin-top: clamp(3.5rem, 7vw, 4.5rem);
  }
  .tips :global(.tip .paper-card__body) {
    height: 100%;
    align-content: start;
    padding: 1.8rem 1.5rem 1.7rem;
  }
  .tip__soon {
    margin: 0.6rem 0 0;
  }
  :global(.guide-head) {
    margin-top: clamp(4.5rem, 9vw, 6rem);
  }
  .guide {
    max-width: 62rem;
    margin-top: 2rem;
    margin-bottom: clamp(5rem, 10vw, 6rem);
    column-gap: 2rem;
  }
  .guide :global(.guide__group) {
    break-inside: avoid;
    margin-bottom: 2rem;
  }
  .guide :global(.guide__group .paper-card__body) {
    padding: 1.7rem 1.6rem 1.5rem;
  }
  .guide__cat {
    padding-bottom: 0.5rem;
    border-bottom: 1px solid var(--rule);
    text-align: center;
  }
  .guide__list {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .place {
    padding: 0.8rem 0;
    border-bottom: 1px solid var(--rule);
  }
  .place:last-child {
    border-bottom: 0;
  }
  .place__name {
    font-family: var(--font-caps);
    font-weight: 700;
    font-size: 1.3rem;
    color: var(--heading);
  }
  .place__name:hover {
    color: var(--text);
  }
  .place__area {
    display: block;
    font-family: var(--font-caps);
    font-style: italic;
    font-weight: 500;
    font-size: 1.05rem;
    color: var(--soft);
  }
  .place__note {
    margin-top: 0.15rem;
    font-size: 1.1rem;
    line-height: 1.45;
    color: var(--text);
  }
  @media (min-width: 52rem) {
    .tips {
      grid-template-columns: repeat(3, 1fr);
    }
    .guide {
      columns: 2;
    }
  }
  @media (min-width: 60rem) {
    .trip {
      grid-template-columns: 28rem 1fr;
    }
  }
</style>
