---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import { inlineMd } from '../lib/inline-md';
import { site } from '../config';

const faqs = (await getCollection('faq')).map((f) => f.data);
---

<Base title="FAQ" description="Questions and answers about Ally & Mark’s wedding.">
  <PageHeader kicker="FAQ" title="Questions & answers" lead="The things people ask us most. We’ll add more as plans bloom." />

  <section class="container faq-list">
    {
      faqs.map((f, i) => (
        <details class="faq glass reveal" open={i < 2}>
          <summary>
            <span>{f.question}</span>
            <span class="faq__icon" aria-hidden="true" />
          </summary>
          <div class="faq__answer" set:html={inlineMd(f.answer)} />
        </details>
      ))
    }
    {
      site.contactEmail && (
        <p class="faq-contact">
          Still wondering about something? Email us at <a href={`mailto:${site.contactEmail}`}>{site.contactEmail}</a>.
        </p>
      )
    }
  </section>
</Base>

<style>
  .faq-list {
    display: grid;
    gap: 0.9rem;
    max-width: 46rem;
  }
  .faq {
    padding: 0;
  }
  .faq summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 1.1rem 1.4rem;
    cursor: pointer;
    list-style: none;
    font-family: var(--font-display);
    font-size: 1.55rem;
    font-weight: 600;
    line-height: 1.25;
    color: var(--green-900);
  }
  .faq summary::-webkit-details-marker {
    display: none;
  }
  .faq__icon {
    position: relative;
    flex: none;
    width: 1.6rem;
    height: 1.6rem;
    border: 1px solid var(--brass-500);
    border-radius: 50%;
  }
  .faq__icon::before,
  .faq__icon::after {
    content: '';
    position: absolute;
    left: 50%;
    top: 50%;
    width: 0.7rem;
    height: 1.5px;
    background: var(--green-900);
    translate: -50% -50%;
    transition: rotate 200ms var(--ease);
  }
  .faq__icon::after {
    rotate: 90deg;
  }
  .faq[open] .faq__icon::after {
    rotate: 0deg;
  }
  .faq__answer {
    padding: 0 1.4rem 1.3rem;
    color: var(--ink);
  }
  .faq-contact {
    margin-top: 1rem;
    text-align: center;
  }
</style>
