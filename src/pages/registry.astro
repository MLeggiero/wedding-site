---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import FloralSection from '../components/FloralSection.astro';
import SectionHeading from '../components/SectionHeading.astro';
import PaperCard from '../components/PaperCard.astro';
import HeroFrame from '../components/HeroFrame.astro';
import SecretDuck from '../components/SecretDuck.astro';
import { photo } from '../lib/photos';
import { site } from '../config';

const charities = (await getCollection('charities')).map((c) => c.data);
const registry = [
  { name: 'Honeymoon fund', note: 'our first adventure together' },
  { name: 'Home & garden', note: 'a short list for our first home' },
  { name: 'Giving back', note: 'gifts in our honor to two causes we love' },
];
---

<Base title="Registry" description="Ally & Mark’s registry: a honeymoon fund, a few gifts and two causes close to their hearts.">
  <FloralSection flora="full" label="Gifts">
    <SectionHeading eyebrow="registry" title="Gifts & giving" lead="You being there is a gift." />

    <div class="gifts container">
      <div class="gifts__photo">
        <HeroFrame photo={photo('garden-redbud')} art="arch" sizes="(min-width: 60rem) 26rem, 80vw" />
      </div>
      <PaperCard class="gifts__card" sprigs="two" width="fill" as="section">
        <p class="tag">Opening in {site.registryOpens}</p>
        <h2 class="cc-title gifts__title">Our registry</h2>
        <ul class="gift-list">
          {
            registry.map((r) => (
              <li>
                <span class="gift-list__name">{r.name}</span>
                <span class="gift-list__note">{r.note}</span>
              </li>
            ))
          }
        </ul>
      </PaperCard>
    </div>

    <SectionHeading level={2} size="section" title="Giving back" lead="Two causes close to our hearts." class="gifts__give" />
    <div class="causes container">
      {
        charities.map((c) => (
          <PaperCard sprigs="none" width="fill" as="article" class="cause">
            <h3 class="cc-title">{c.name}</h3>
            <p class="cc-text">{c.blurb}</p>
            <a class="btn btn--small cause__link" href={c.url} target="_blank" rel="noopener">
              Visit<span class="visually-hidden"> {c.name}</span>
            </a>
          </PaperCard>
        ))
      }
    </div>

    <SecretDuck slot="decor" class="gifts__duck" />
  </FloralSection>
</Base>

<style>
  .gifts {
    display: grid;
    gap: clamp(3rem, 6vw, 4rem);
    align-items: center;
    max-width: 64rem;
    margin-top: clamp(2.5rem, 6vw, 4rem);
  }
  .gifts__photo {
    width: min(100%, 28rem);
    margin-inline: auto;
  }
  .gifts :global(.gifts__card) {
    width: min(100%, 30rem);
    margin-inline: auto;
    text-align: center;
  }
  .gifts__title {
    margin-top: 0.4rem;
    text-align: center;
  }
  .gift-list {
    list-style: none;
    margin: 1.1rem 0 0;
    padding: 0;
    border-top: 1px solid var(--rule);
  }
  .gift-list li {
    display: grid;
    gap: 0.1rem;
    padding: 0.8rem 0;
    border-bottom: 1px solid var(--rule);
    text-align: center;
  }
  .gift-list__name {
    font-family: var(--font-caps);
    font-weight: 600;
    font-size: 1rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--heading);
  }
  .gift-list__note {
    font-style: italic;
    font-size: 1.1rem;
    color: var(--soft);
  }
  :global(.gifts__give) {
    margin-top: clamp(4rem, 9vw, 6rem);
  }
  .causes {
    display: grid;
    gap: 2rem;
    max-width: 52rem;
    margin-top: 2rem;
    margin-bottom: clamp(5rem, 10vw, 6rem);
  }
  .causes :global(.cause .paper-card__body) {
    display: grid;
    justify-items: center;
    gap: 0.7rem;
    height: 100%;
    padding: 2rem 1.8rem 1.9rem;
    text-align: center;
  }
  .cause__link {
    align-self: end;
    margin-top: 0.4rem;
  }
  /* the duck walks the ruled line at the foot of the page */
  :global(.gifts__duck) {
    left: calc(50% + min(6rem, 8vw));
    bottom: calc(-0.15rem - 3px);
  }
  /* phones: a short walk in the open ground between the two clusters of plants */
  @media (max-width: 47.99rem) {
    :global(.gifts__duck) {
      left: calc(50% - 1.2rem);
      --duck-walk: 2rem;
    }
  }
  @media (min-width: 52rem) {
    .gifts {
      grid-template-columns: 28rem 1fr;
    }
    .causes {
      grid-template-columns: 1fr 1fr;
    }
  }
</style>
