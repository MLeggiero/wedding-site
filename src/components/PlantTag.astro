---
// A brass plant-marker label — used for dates, times and little facts.
interface Props {
  class?: string;
  as?: 'span' | 'p';
}
const { class: cls, as: Tag = 'span' } = Astro.props;
---

<Tag class:list={['plant-tag', cls]}><span class="plant-tag__pin" aria-hidden="true"></span><span><slot /></span></Tag>

<style>
  .plant-tag {
    display: inline-flex;
    align-items: center;
    gap: 0.6em;
    padding: 0.38em 1.05em 0.38em 0.7em;
    background: linear-gradient(180deg, #e6d4ad, var(--sand-300));
    color: var(--green-900);
    border: 1px solid var(--brass-500);
    border-radius: 3px 999px 999px 3px;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1.05rem;
    letter-spacing: 0.06em;
    line-height: 1.25;
    font-variant-numeric: lining-nums;
    box-shadow:
      inset 0 1px 0 rgb(255 255 255 / 0.5),
      0 6px 14px -10px rgb(46 34 25 / 0.6);
  }
  .plant-tag__pin {
    flex: none;
    width: 0.5em;
    height: 0.5em;
    border-radius: 50%;
    background: var(--linen-50);
    box-shadow: inset 0 0 0 1px var(--brass-500);
  }
</style>
