---
import Base from '../layouts/Base.astro';
import CozyRoom from '../components/CozyRoom.astro';
import RoomHeading from '../components/RoomHeading.astro';
import { withBase } from '../lib/url';
---

<Base title="Off the path">
  <CozyRoom flora="full" label="Page not found" class="lost">
    <RoomHeading eyebrow="Page not found" title="Off the path" lead="This corner of the garden hasn’t been planted yet." />
    <p class="lost__home"><a class="btn-plate" href={withBase('/')}>Back to the garden</a></p>
  </CozyRoom>
</Base>

<style>
  .lost {
    --room-pad: clamp(6rem, 12vw, 8rem) clamp(10rem, 18vw, 13rem);
    display: grid;
    align-content: center;
    min-height: min(52rem, 88svh);
  }
  .lost__home {
    display: flex;
    justify-content: center;
    margin-top: 2.2rem;
  }
</style>
