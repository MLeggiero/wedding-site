---
// The secret door: an engraved duck that waddles back and forth along the
// ruled line at the foot of the Registry page. It is the only link to the
// Secret Registry. Hover or focus stops it for a little hop; with reduced
// motion it simply stands still.
import { withBase } from '../lib/url';

interface Props {
  class?: string;
}
const { class: cls } = Astro.props;
---

<a class:list={['secret-duck', cls]} href={withBase('/secret-registry/')} aria-label="Secret Registry" title="Secret Registry">
  <svg viewBox="0 0 72 56" aria-hidden="true" focusable="false">
    <g class="secret-duck__bird" fill="var(--paper)" stroke="var(--ink)" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round">
      <g class="secret-duck__leg secret-duck__leg--back">
        <path d="M44,41 L44.5,51.5" fill="none"></path>
        <path d="M45,51.6 L37.6,53.2 L38.8,50.2 Z" fill="var(--ink)"></path>
      </g>
      <g class="secret-duck__leg secret-duck__leg--front">
        <path d="M37,41 L36.5,51.5" fill="none"></path>
        <path d="M37,51.6 L29.6,53.2 L30.8,50.2 Z" fill="var(--ink)"></path>
      </g>
      <path d="M14,24 C13,15 21,10 27,12 C33,14 34,21 31,26 C40,23 51,23 58,18 C62,16 64,20 62,24 C61,33 54,44 40,45 C27,46 18,40 18,33 C18,30 19,28 21,27 C18,27 15,26 14,24Z"></path>
      <path d="M14,22 C9,22 5,23 3,25 C6,27 10,27 15,26Z"></path>
      <path d="M30,33 C37,29 47,29 53,32 C47,37 38,38 30,33Z"></path>
      <path d="M34,33 L50,32 M33,35 L48,35 M54,22 L59,24 M53,25 L58,27" stroke-width=".6" fill="none"></path>
      <circle cx="22" cy="19" r="1.6" fill="var(--ink)" stroke="none"></circle>
    </g>
  </svg>
</a>

<style>
  .secret-duck {
    --duck-path: min(12rem, 28vw);
    position: absolute;
    z-index: 3;
    display: block;
    width: 4.6rem;
    padding: 0.15rem;
    border-radius: 6px;
  }
  .secret-duck svg {
    width: 100%;
    height: auto;
    overflow: visible;
  }
  .secret-duck__bird {
    transform-origin: 40px 50px;
  }
  .secret-duck__leg--front {
    transform-origin: 37px 41px;
  }
  .secret-duck__leg--back {
    transform-origin: 44px 41px;
  }
  @media (prefers-reduced-motion: no-preference) {
    /* along the line and back, turning at each end (it faces left as drawn) */
    .secret-duck {
      animation: duck-path 18s linear infinite;
    }
    .secret-duck__bird {
      animation: duck-waddle 0.55s ease-in-out infinite alternate;
    }
    .secret-duck__leg--front {
      animation: duck-step 0.55s ease-in-out infinite alternate;
    }
    .secret-duck__leg--back {
      animation: duck-step 0.55s ease-in-out infinite alternate-reverse;
    }
    .secret-duck:hover,
    .secret-duck:focus-visible {
      animation-play-state: paused;
    }
    .secret-duck:hover :is(.secret-duck__bird, .secret-duck__leg),
    .secret-duck:focus-visible :is(.secret-duck__bird, .secret-duck__leg) {
      animation: duck-hop 0.35s ease-in-out infinite alternate;
    }
    @keyframes duck-path {
      0% {
        translate: 0 0;
        scale: 1 1;
      }
      45% {
        translate: calc(-1 * var(--duck-path)) 0;
        scale: 1 1;
      }
      50% {
        translate: calc(-1 * var(--duck-path)) 0;
        scale: -1 1;
      }
      95% {
        translate: 0 0;
        scale: -1 1;
      }
      100% {
        translate: 0 0;
        scale: 1 1;
      }
    }
    @keyframes duck-waddle {
      from {
        rotate: -4deg;
      }
      to {
        rotate: 4deg;
      }
    }
    @keyframes duck-step {
      from {
        rotate: -16deg;
      }
      to {
        rotate: 16deg;
      }
    }
    @keyframes duck-hop {
      from {
        translate: 0 0;
      }
      to {
        translate: 0 -3px;
      }
    }
  }
</style>
