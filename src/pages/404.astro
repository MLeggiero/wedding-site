---
import Base from '../layouts/Base.astro';
import FloralSection from '../components/FloralSection.astro';
import SectionHeading from '../components/SectionHeading.astro';
import { withBase } from '../lib/url';
---

<Base title="Page not found">
  <FloralSection flora="full" label="Page not found" class="lost">
    <SectionHeading eyebrow="page not found" title="Off the path" />
    <p class="lost__home"><a class="btn" href={withBase('/')}>Home</a></p>
  </FloralSection>
</Base>

<style>
  .lost {
    --room-pad: clamp(6rem, 12vw, 8rem) clamp(10rem, 18vw, 13rem);
    display: grid;
    align-content: center;
    min-height: min(52rem, 88svh);
  }
  .lost__home {
    display: flex;
    justify-content: center;
    margin-top: 2rem;
  }
  .lost__home .btn {
    min-width: 11rem;
  }
</style>
