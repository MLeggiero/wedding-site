---
// Behind the courtesy password: the day's schedule, garden map, hotel blocks
// and RSVP. Placeholder until invitations go out.
import Base from '../../layouts/Base.astro';
import FloralSection from '../../components/FloralSection.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import PaperCard from '../../components/PaperCard.astro';
import PasswordGate from '../../components/PasswordGate.astro';
import { withBase } from '../../lib/url';
import { site } from '../../config';
---

<Base title="Details & RSVP" description="Schedule, garden map and RSVP for Ally & Mark’s wedding guests.">
  <FloralSection flora="full" label="Details and RSVP">
    <SectionHeading eyebrow="details & RSVP" title="For our guests" />
    <PaperCard class="details-card" as="section">
      <PasswordGate>
        <div class="soon">
          <p class="tag">{site.dateLong}</p>
          <h2 class="cc-title">Schedule, map and RSVP</h2>
          <p class="cc-text">They arrive here with the invitations in {site.invitationsSend}.</p>
          <p class="soon__links cc-text">
            <a href={withBase('/travel/')}>Travel</a> · <a href={withBase('/faq/')}>FAQ</a> ·
            <a href={withBase('/our-story/')}>Our Story</a>
          </p>
        </div>
      </PasswordGate>
    </PaperCard>
  </FloralSection>
</Base>

<style>
  :global(.details-card) {
    margin-block: clamp(3rem, 8vw, 4.5rem) clamp(4rem, 9vw, 5rem);
  }
  .soon {
    display: grid;
    justify-items: center;
    gap: 0.6rem;
    text-align: center;
  }
  .soon .tag {
    margin-bottom: 0.8rem;
  }
  .soon__links {
    margin-top: 0.4rem;
  }
</style>
