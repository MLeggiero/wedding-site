---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import FloralSection from '../components/FloralSection.astro';
import SectionHeading from '../components/SectionHeading.astro';
import PaperCard from '../components/PaperCard.astro';
import { inlineMd } from '../lib/inline-md';
import { site } from '../config';

const faqs = (await getCollection('faq')).map((f) => f.data);
---

<Base title="FAQ" description="Questions and answers about Ally & Mark’s wedding.">
  <FloralSection flora="full" label="Questions and answers">
    <SectionHeading title="Questions" />
    <PaperCard class="faq-card" sprigs="top" as="section">
      <div class="faq-list">
        {
          faqs.map((f, i) => (
            <details class="faq" open={i < 2}>
              <summary>
                <span>{f.question}</span>
                <span class="faq__icon" aria-hidden="true" />
              </summary>
              <div class="faq__answer cc-text" set:html={inlineMd(f.answer)} />
            </details>
          ))
        }
      </div>
      {
        site.contactEmail && (
          <p class="faq-contact cc-text">
            Still wondering? Email us at <a href={`mailto:${site.contactEmail}`}>{site.contactEmail}</a>.
          </p>
        )
      }
    </PaperCard>
  </FloralSection>
</Base>

<style>
  :global(.faq-card) {
    margin-block: clamp(3rem, 8vw, 4.5rem) clamp(4rem, 9vw, 5rem);
  }
  .faq-list {
    border-top: 1px solid var(--rule);
  }
  .faq {
    border-bottom: 1px solid var(--rule);
  }
  .faq summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    min-height: 3.2rem;
    padding: 0.85rem 0.2rem;
    cursor: pointer;
    list-style: none;
    font-family: var(--font-caps);
    font-weight: 700;
    font-size: clamp(1.28rem, 1.2rem + 0.35vw, 1.45rem);
    line-height: 1.3;
    color: var(--heading);
  }
  .faq summary::-webkit-details-marker {
    display: none;
  }
  .faq summary:hover {
    color: var(--text);
  }
  .faq summary:focus-visible {
    outline: 2px solid var(--heading);
    outline-offset: 2px;
  }
  .faq__icon {
    position: relative;
    flex: none;
    width: 1.6rem;
    height: 1.6rem;
    border-radius: 50%;
    box-shadow: inset 0 0 0 1px var(--ink);
  }
  .faq__icon::before,
  .faq__icon::after {
    content: '';
    position: absolute;
    left: 50%;
    top: 50%;
    width: 0.7rem;
    height: 1.5px;
    background: var(--heading);
    translate: -50% -50%;
    transition: rotate 200ms var(--ease);
  }
  .faq__icon::after {
    rotate: 90deg;
  }
  .faq[open] .faq__icon::after {
    rotate: 0deg;
  }
  .faq__answer {
    padding: 0 0.2rem 1.1rem;
  }
  .faq-contact {
    margin-top: 1.2rem;
    text-align: center;
  }
</style>
