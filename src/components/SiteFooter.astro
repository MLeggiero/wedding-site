---
// The footer, set like the back of an invitation: monogram, names in script,
// the date in spaced capitals, the place in italics. No plants: the section
// above ends on a bed of them.
import { nav, guestLinks, site } from '../config';
import { withBase } from '../lib/url';
import { photoCredits } from '../lib/photos';
import Monogram from './Monogram.astro';
import Divider from './Divider.astro';
---

<footer class="site-footer">
  <div class="container site-footer__inner">
    <Monogram class="site-footer__mono" label="Ally and Mark" />
    <p class="site-footer__names t-script">Ally &amp; Mark</p>
    <Divider class="site-footer__divider" />
    <p class="site-footer__date t-caps">{site.dateKicker}</p>
    <p class="site-footer__place t-italic">{site.venue}<br />{site.city}</p>

    <nav aria-label="Footer">
      {
        [nav, guestLinks].map((group) => (
          <ul>
            {group.map((item) => (
              <li>
                <a href={withBase(item.href)}>{item.label}</a>
              </li>
            ))}
          </ul>
        ))
      }
    </nav>

    {
      site.contactEmail && (
        <p class="site-footer__small">
          Questions? <a href={`mailto:${site.contactEmail}`}>{site.contactEmail}</a>
        </p>
      )
    }
    {site.photoCredit && <p class="site-footer__small">{site.photoCredit}</p>}
    {photoCredits.length > 0 && <p class="site-footer__small">Garden photos: {photoCredits.join(', ')}</p>}
    <slot />
  </div>
</footer>

<style>
  .site-footer {
    position: relative;
    overflow: hidden;
    padding-block: 3rem 4.5rem;
    border-top: 1px solid var(--rule);
    text-align: center;
  }
  .site-footer__inner {
    position: relative;
    z-index: 2;
    display: grid;
    justify-items: center;
    gap: 0.35rem;
  }
  .site-footer :global(.site-footer__mono) {
    width: 2.4rem;
    color: var(--ink);
  }
  .site-footer__names {
    font-size: clamp(3rem, 2.4rem + 2.4vw, 4rem);
    line-height: 1.1;
  }
  .site-footer :global(.site-footer__divider) {
    width: min(11rem, 60%);
  }
  .site-footer__date {
    margin-top: 0.3rem;
    font-size: 0.92rem;
  }
  .site-footer__place {
    font-size: 1.12rem;
    line-height: 1.4;
  }
  .site-footer nav {
    margin-top: 1rem;
  }
  .site-footer ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0 1.4rem;
    max-width: 46rem;
  }
  .site-footer nav a {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    font-family: var(--font-caps);
    font-weight: 600;
    font-size: 0.8rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--heading);
    text-decoration: none;
  }
  .site-footer nav a:hover {
    text-decoration: underline;
    text-decoration-color: var(--rule);
    text-underline-offset: 0.3em;
  }
  .site-footer__small {
    margin-top: 0.4rem;
    font-size: 1rem;
    color: var(--soft);
  }
</style>
