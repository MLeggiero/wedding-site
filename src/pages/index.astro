---
import Base from '../layouts/Base.astro';
import HeroFrame from '../components/HeroFrame.astro';
import GiltCard from '../components/GiltCard.astro';
import Photo from '../components/Photo.astro';
import Countdown from '../components/Countdown.astro';
import CozyRoom from '../components/CozyRoom.astro';
import Flourish from '../components/Flourish.astro';
import { photo } from '../lib/photos';
import { withBase } from '../lib/url';
import { guestLinks, site } from '../config';

const cards = [
  { href: '/our-story/', kicker: 'Our story', title: 'The question', photo: photo('20'), cta: 'Read it' },
  { href: '/travel/', kicker: 'Travel', title: 'Getting to Athens', photo: photo('62'), cta: 'Plan your trip' },
  { href: '/registry/', kicker: 'Registry', title: 'Gifts & giving', photo: photo('40'), cta: 'Take a look' },
];
---

<Base>
  <CozyRoom
    class="hero"
    glow="70% 42%"
    fireflies={[
      [52, 14, 3.6, 0],
      [61, 30, 5.1, 1.2],
      [94, 22, 4.4, 0.6],
      [88, 58, 3.9, 2.1],
      [57, 72, 4.8, 0.3],
      [96, 82, 5.4, 1.7],
      [46, 46, 4.2, 2.6],
      [72, 6, 4.6, 1],
      [8, 88, 5, 0.8],
      [36, 8, 4.1, 1.9],
    ]}
  >
    <div class="container hero__grid">
      <div class="hero__art">
        <HeroFrame photo={photo('35')} />
      </div>

      <div class="hero__text">
        <p class="hero__eyebrow">Save the date</p>
        <h1 class="hero__names">
          <span>Ally</span>
          <span class="hero__amp">&amp;</span>
          <span>Mark</span>
        </h1>
        <Flourish class="hero__flourish" />
        <p class="hero__date">{site.dateKicker}</p>
        <p class="hero__venue">{site.venue}<br />{site.city}</p>
        <div class="hero__plate"><Countdown variant="plain" /></div>
        <p class="hero__note">Formal invitation to follow</p>
      </div>
    </div>
  </CozyRoom>

  <CozyRoom class="explore" label="Explore" flora="small" fireflies={[[6, 30, 4.6, 0.3], [94, 60, 5.2, 1.6], [50, 92, 4.2, 2.4]]}>
    <div class="container cards">
      {
        cards.map((c) => (
          <GiltCard sprigs="none" width="fill" as="article" class="card">
            <div class="card__photo">
              <Photo photo={c.photo} sizes="(min-width: 64rem) 20rem, (min-width: 40rem) 42vw, 80vw" widths={[480, 800, 1200]} />
            </div>
            <p class="cc-kicker">{c.kicker}</p>
            <h2 class="cc-title">
              <a class="card__link" href={withBase(c.href)}>
                {c.title}
              </a>
            </h2>
            <span class="card__cta" aria-hidden="true">
              {c.cta} →
            </span>
          </GiltCard>
        ))
      }
    </div>
  </CozyRoom>

  <CozyRoom
    class="join"
    label="Join in"
    flora="small"
    fireflies={[
      [30, 20, 4.4, 0.5],
      [70, 78, 5, 1.4],
      [62, 14, 4, 2.2],
      [22, 70, 4.8, 1.1],
      [80, 30, 4.2, 0.2],
    ]}
  >
    <div class="join__inner">
      <h2 class="join__title">Join in</h2>
      <Flourish class="join__flourish" />
      <div class="join__links">
        {
          guestLinks.map((l) => (
            <a class="btn-plate" href={withBase(l.href)}>
              {l.label}
            </a>
          ))
        }
      </div>
    </div>
  </CozyRoom>
</Base>

<style>
  /* ---------- hero: cozy maximalist (room, border and fireflies come from CozyRoom) ---------- */
  .hero {
    --room-pad: clamp(1.5rem, 4vw, 3.5rem) clamp(2.5rem, 6vw, 4.5rem);
  }
  .hero__grid {
    position: relative;
    z-index: 2;
    display: grid;
    gap: clamp(1.5rem, 4vw, 3rem);
    align-items: center;
  }
  .hero__art {
    width: min(100%, 40rem);
    margin-inline: auto;
  }
  .hero__text {
    display: grid;
    justify-items: center;
    gap: 0.7rem;
    text-align: center;
  }
  .hero__eyebrow {
    font-family: 'IM Fell English SC', Georgia, serif;
    font-size: 1.35rem;
    letter-spacing: 0.32em;
    color: #e0a84f;
  }
  .hero__names {
    display: grid;
    justify-items: center;
    padding: 0.12em 0.45em 0.32em;
    font-family: 'Ballet', 'Pinyon Script', cursive;
    font-weight: 400;
    font-size: clamp(4.6rem, 2.6rem + 7.5vw, 9.2rem);
    line-height: 1.02;
    background: linear-gradient(172deg, #fff0bf 6%, #d9ab4e 38%, #f7dc90 56%, #a8772a 86%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    filter: drop-shadow(0 3px 1px rgb(0 0 0 / 0.45));
  }
  .hero__amp {
    font-size: 0.58em;
    line-height: 0.95;
  }
  .hero__text :global(.hero__flourish) {
    width: min(19rem, 80%);
    color: #d9ab4e;
    margin-top: -1.4rem;
  }
  .hero__date {
    font-family: 'Playfair Display Variable', Georgia, serif;
    font-weight: 600;
    font-size: clamp(1.15rem, 0.95rem + 0.8vw, 1.55rem);
    letter-spacing: 0.24em;
    text-transform: uppercase;
    font-variant-numeric: lining-nums;
    color: #f6ead0;
  }
  .hero__venue {
    font-family: 'EB Garamond Variable', Georgia, serif;
    font-style: italic;
    font-size: clamp(1.3rem, 1.15rem + 0.5vw, 1.6rem);
    line-height: 1.35;
    color: #e8d9b6;
  }
  .hero__plate {
    margin-top: 0.4rem;
    padding: 0.7rem 1.6rem 0.8rem;
    border-radius: 4px;
    background: linear-gradient(180deg, #7a2637, #561826);
    box-shadow:
      0 0 0 2px #c79d40,
      0 0 0 6px #561826,
      0 0 0 7.5px #e9cf85,
      0 14px 30px -12px rgb(0 0 0 / 0.75);
    font-family: 'IM Fell English SC', Georgia, serif;
    font-size: clamp(1.2rem, 1.05rem + 0.45vw, 1.42rem);
    letter-spacing: 0.05em;
    color: #f8ead0;
  }
  .hero__plate :global(strong) {
    font-family: 'Playfair Display Variable', Georgia, serif;
    font-weight: 700;
    font-size: 1.55em;
    color: #f2d27e;
    margin-right: 0.15em;
    font-variant-numeric: lining-nums;
  }
  .hero__note {
    margin-top: 0.3rem;
    font-family: 'Playfair Display Variable', Georgia, serif;
    font-style: italic;
    font-size: 1.3rem;
    color: #e0a84f;
  }
  @media (min-width: 64rem) {
    .hero__grid {
      grid-template-columns: 0.9fr 1.2fr;
    }
    .hero__art {
      order: 2;
    }
  }

  /* ---------- join in ---------- */
  .join {
    --room-pad: clamp(3rem, 7vw, 4.5rem);
  }
  .join__inner {
    display: grid;
    justify-items: center;
    gap: 1.6rem;
    text-align: center;
  }
  .join__title {
    padding: 0.05em 0.4em 0.2em;
    font-family: 'Ballet', 'Playfair Display Variable', cursive;
    font-weight: 400;
    font-size: clamp(3.2rem, 2.2rem + 4vw, 5rem);
    line-height: 1.1;
    background: linear-gradient(172deg, #fff0bf 6%, #d9ab4e 38%, #f7dc90 56%, #a8772a 86%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    filter: drop-shadow(0 3px 1px rgb(0 0 0 / 0.45));
  }
  .join__inner :global(.join__flourish) {
    width: min(15rem, 66%);
    margin-top: -1.9rem;
    color: #d9ab4e;
  }
  .join__links {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 1.6rem 2rem;
  }
  .join__links .btn-plate {
    min-width: 15rem;
  }

  /* ---------- cards ---------- */
  .explore {
    --room-pad: clamp(3.5rem, 7vw, 5rem);
  }
  .cards {
    display: grid;
    gap: clamp(2rem, 4vw, 2.6rem);
    grid-template-columns: repeat(auto-fit, minmax(16.5rem, 1fr));
  }
  .cards :global(.card .gilt-card__body) {
    display: grid;
    justify-items: center;
    gap: 0.3rem;
    padding: 1.4rem 1.4rem 1.6rem;
    text-align: center;
  }
  .card__photo {
    width: 100%;
    aspect-ratio: 0.86;
    margin-bottom: 0.9rem;
    overflow: hidden;
    border-radius: 50% 50% 3px 3px / 36% 36% 3px 3px;
    box-shadow:
      0 0 0 2px #c79d40,
      0 0 0 5px #f6ecd6,
      0 0 0 6.5px #a07a35;
  }
  .card__photo :global(picture),
  .card__photo :global(img) {
    width: 100%;
    height: 100%;
  }
  .card__photo :global(img) {
    object-fit: cover;
    object-position: var(--focus);
  }
  .card__link {
    color: inherit;
    text-decoration: none;
  }
  .card__link::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 3;
  }
  .card__link:focus-visible {
    outline: none;
  }
  .cards :global(.card:has(.card__link:focus-visible)) {
    outline: 2px solid #f2d27e;
    outline-offset: 10px;
  }
  .cards :global(.card:hover .cc-title) {
    color: #5e1a29;
  }
  .card__cta {
    font-family: 'IM Fell English SC', Georgia, serif;
    font-size: 1.1rem;
    color: #5e1a29;
  }
</style>
