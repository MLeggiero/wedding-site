---
// One hidden SVG sprite per page; <Foliage> instances reference its symbols.
import { BOTANICALS } from '../lib/botanicals';
---

<svg class="sprite" aria-hidden="true" focusable="false" width="0" height="0">
  {Object.values(BOTANICALS).map((b) => <symbol id={b.id} viewBox={b.viewBox} set:html={b.markup} />)}
</svg>

<style>
  .sprite {
    position: absolute;
    width: 0;
    height: 0;
    overflow: hidden;
  }
</style>
