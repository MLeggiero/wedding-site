---
// Thin Victorian scrollwork with a little glasshouse window at its heart.
interface Props {
  class?: string;
}
const { class: cls } = Astro.props;

// Right-hand half; the left half is a mirror image.
const half = [
  'M318,33 H422', // rail
  'M316,41 C327,41 331,30 341,30 C350,30 352,38.5 346,40.2 C341,41.5 338,36.5 342,34.8', // C-scroll
  'M422,33 C434,33 437,25 446,25 C453.5,25 455,31.5 450,32.8 C446.5,33.6 444.6,29.6 447.6,28.6', // second scroll
  'M446,33 H556', // fine rail
].join(' ');
const leaves = [
  'M360,33 C362,26 368,22.5 376,22.5 C373,28.5 368,32.5 360,33 Z',
  'M384,33 C386,27.5 391,24.5 397.5,24.5 C395,29.5 391,32.6 384,33 Z',
  'M366,33 C368,38 373,40.8 379,40.8 C376.8,36.6 372.6,33.6 366,33 Z',
  'M470,33 C471.5,28.6 475.5,26.2 481,26.2 C479,30.2 475.6,32.6 470,33 Z',
].join(' ');
---

<svg class:list={['ironwork', cls]} viewBox="0 0 600 48" aria-hidden="true" focusable="false">
  <g class="iw-line">
    <path d={half}></path>
    <path d={half} transform="matrix(-1 0 0 1 600 0)"></path>
    <!-- central glasshouse window -->
    <path d="M288,41 V27 A12,12 0 0 1 312,27 V41 Z M288,27 H312 M300,15 V41 M300,27 L291.5,18.5 M300,27 L308.5,18.5"></path>
  </g>
  <g class="iw-fill">
    <path d={leaves}></path>
    <path d={leaves} transform="matrix(-1 0 0 1 600 0)"></path>
    <path d="M556,33 l5,-3.4 l5,3.4 l-5,3.4 Z M44,33 l-5,-3.4 l-5,3.4 l5,3.4 Z"></path>
  </g>
</svg>

<style>
  .ironwork {
    width: min(100%, 36rem);
    height: auto;
    margin-inline: auto;
    color: var(--brass-500);
  }
  .iw-line {
    fill: none;
    stroke: currentColor;
    stroke-width: 1.4;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .iw-fill {
    fill: currentColor;
    opacity: 0.9;
  }
</style>
