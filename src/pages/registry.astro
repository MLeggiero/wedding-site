---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import CozyRoom from '../components/CozyRoom.astro';
import RoomHeading from '../components/RoomHeading.astro';
import GiltCard from '../components/GiltCard.astro';
import HeroFrame from '../components/HeroFrame.astro';
import BrassDuck from '../components/BrassDuck.astro';
import { photo } from '../lib/photos';
import { site } from '../config';

const charities = (await getCollection('charities')).map((c) => c.data);
const registry = [
  { name: 'Honeymoon fund', note: 'our first adventure together' },
  { name: 'Home & garden', note: 'a short list for our first home' },
  { name: 'Giving back', note: 'gifts in our honor to two causes we love' },
];
---

<Base title="Registry" description="Ally & Mark’s registry: a honeymoon fund, a few gifts and two causes close to their hearts.">
  <CozyRoom flora="full" label="Gifts">
    <RoomHeading eyebrow="Registry" title="Gifts & giving" lead="Your being there is the gift." />

    <div class="gifts container">
      <div class="gifts__photo">
        <HeroFrame photo={photo('40')} art="arch" sizes="(min-width: 60rem) 26rem, 80vw" />
      </div>
      <GiltCard class="gifts__card" sprigs="two" width="fill" as="section">
        <p class="plate-tag">Opening in {site.registryOpens}</p>
        <h2 class="cc-title gifts__title">Our registry</h2>
        <ul class="gift-list">
          {
            registry.map((r) => (
              <li>
                <span class="gift-list__name">{r.name}</span>
                <span class="gift-list__note">{r.note}</span>
              </li>
            ))
          }
        </ul>
      </GiltCard>
    </div>

    <RoomHeading level={2} size="section" title="Giving back" lead="Two causes close to our hearts." class="gifts__give" />
    <div class="causes container">
      {
        charities.map((c) => (
          <GiltCard sprigs="none" width="fill" as="article" class="cause">
            <h3 class="cc-title">{c.name}</h3>
            <p class="cc-text">{c.blurb}</p>
            <a class="btn-plate btn-plate--small cause__link" href={c.url} target="_blank" rel="noopener">
              Visit<span class="visually-hidden"> {c.name}</span>
            </a>
          </GiltCard>
        ))
      }
    </div>

    <BrassDuck class="gifts__duck" />
  </CozyRoom>
</Base>

<style>
  .gifts {
    display: grid;
    gap: clamp(3rem, 6vw, 4rem);
    align-items: center;
    max-width: 64rem;
    margin-top: clamp(3.5rem, 7vw, 5rem);
  }
  .gifts__photo {
    width: min(100%, 28rem);
    margin-inline: auto;
  }
  .gifts :global(.gifts__card) {
    width: min(100%, 30rem);
    margin-inline: auto;
  }
  .gifts__title {
    margin-top: 0.4rem;
    text-align: center;
  }
  .gift-list {
    list-style: none;
    margin: 1.1rem 0 0;
    padding: 0;
    border-top: 1px solid rgb(168 130 58 / 0.5);
  }
  .gift-list li {
    display: grid;
    gap: 0.1rem;
    padding: 0.8rem 0;
    border-bottom: 1px solid rgb(168 130 58 / 0.35);
    text-align: center;
  }
  .gift-list__name {
    font-family: 'IM Fell English SC', Georgia, serif;
    font-size: 1.3rem;
    color: #18301f;
  }
  .gift-list__note {
    font-family: 'EB Garamond Variable', Georgia, serif;
    font-style: italic;
    font-size: 1.1rem;
    color: #5b4330;
  }
  :global(.gifts__give) {
    margin-top: clamp(4rem, 9vw, 6rem);
  }
  .causes {
    display: grid;
    gap: 2rem;
    max-width: 52rem;
    margin-top: 2rem;
    margin-bottom: clamp(5rem, 10vw, 6rem);
  }
  .causes :global(.cause .gilt-card__body) {
    display: grid;
    justify-items: center;
    gap: 0.7rem;
    height: 100%;
    padding: 2rem 1.8rem 1.9rem;
    text-align: center;
  }
  .cause__link {
    align-self: end;
    margin-top: 0.4rem;
  }
  :global(.gifts__duck) {
    right: clamp(4.5rem, 14vw, 13rem);
    bottom: -3.3rem;
  }
  @media (min-width: 52rem) {
    .gifts {
      grid-template-columns: 28rem 1fr;
    }
    .causes {
      grid-template-columns: 1fr 1fr;
    }
  }
</style>
