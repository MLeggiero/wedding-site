---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import ArchFrame from '../components/ArchFrame.astro';
import { photo } from '../lib/photos';
import { inlineMd } from '../lib/inline-md';
import { withBase } from '../lib/url';

const ch = Object.fromEntries((await getCollection('chapters')).map((c) => [c.id, c.data]));
const q = ch['the-question'];
const met = ch['how-we-met'];
---

<Base title="Our Story" description="How Ally & Mark got engaged.">
  <PageHeader kicker="Our Story" title={q.title} />

  <section class="container story">
    <div class="story__photo">
      <ArchFrame photo={photo('20')} bars="frame" aspect={0.85} sizes="(min-width: 52rem) 26rem, 86vw" />
    </div>
    <div class="story__text">
      <p class="lead" set:html={inlineMd(q.body)} />
      <p class="kicker">{met.kicker}</p>
      <p set:html={inlineMd(met.body)} />
      <div class="story__actions">
        <a class="btn" href={withBase('/travel/')}>Plan your trip</a>
        <a class="btn btn--ghost" href={withBase('/registry/')}>Registry</a>
      </div>
    </div>
  </section>
</Base>

<style>
  .story {
    display: grid;
    gap: clamp(1.5rem, 5vw, 3.5rem);
    align-items: center;
    padding-bottom: 2rem;
  }
  .story__photo {
    width: min(100%, 26rem);
    margin-inline: auto;
  }
  .story__text {
    display: grid;
    gap: 0.8rem;
    justify-items: center;
    text-align: center;
  }
  .story__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.8rem;
    justify-content: center;
    margin-top: 0.6rem;
  }
  @media (min-width: 52rem) {
    .story {
      grid-template-columns: 26rem 1fr;
    }
    .story__text {
      justify-items: start;
      text-align: left;
    }
  }
</style>
