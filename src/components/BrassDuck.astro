---
// The secret door: a little brass duck tucked among the plants on the Gifts
// page. It is the only way into After Hours, the robot room.
import { withBase } from '../lib/url';

interface Props {
  class?: string;
}
const { class: cls } = Astro.props;
---

<a
  class:list={['brass-duck', cls]}
  href={withBase('/after-hours/')}
  aria-label="A small brass duck. What’s it doing here?"
  title="A small brass duck. What’s it doing here?"
>
  <svg viewBox="0 0 72 60" aria-hidden="true" focusable="false">
    <defs>
      <linearGradient id="duck-brass" x1="0" y1="0" x2="1" y2="1">
        <stop offset="0" stop-color="#7a5416"></stop>
        <stop offset=".3" stop-color="#f7e3a1"></stop>
        <stop offset=".55" stop-color="#c9973f"></stop>
        <stop offset=".8" stop-color="#efd07c"></stop>
        <stop offset="1" stop-color="#8a6119"></stop>
      </linearGradient>
    </defs>
    <ellipse cx="38" cy="55" rx="22" ry="4" fill="#3b2a12" opacity=".55"></ellipse>
    <path d="M18,52 h40 a4,4 0 0 0 -4,-5 h-32 a4,4 0 0 0 -4,5z" fill="url(#duck-brass)" stroke="#5a3d10" stroke-width="1.2"></path>
    <g class="brass-duck__bird">
      <path
        d="M14,26 C13,17 21,12 27,14 C33,16 34,23 31,28 C40,25 51,25 58,20 C62,18 64,22 62,26 C61,35 54,46 40,47 C27,48 18,42 18,35 C18,32 19,30 21,29 C18,29 15,28 14,26Z"
        fill="url(#duck-brass)"
        stroke="#5a3d10"
        stroke-width="1.4"
        stroke-linejoin="round"></path>
      <path d="M14,24 C9,24 5,25 3,27 C6,29 10,29 15,28Z" fill="#c98a2e" stroke="#5a3d10" stroke-width="1.2" stroke-linejoin="round"></path>
      <path d="M30,35 C37,31 47,31 53,34 C47,39 38,40 30,35Z" fill="none" stroke="#5a3d10" stroke-width="1.3" stroke-linecap="round"></path>
      <circle cx="22" cy="21" r="2.1" fill="#2a1a08"></circle>
      <circle cx="21.4" cy="20.4" r=".6" fill="#fff6d8"></circle>
    </g>
  </svg>
</a>

<style>
  .brass-duck {
    position: absolute;
    z-index: 3;
    display: block;
    width: 3.6rem;
    padding: 0.2rem;
    border-radius: 50%;
    filter: drop-shadow(0 4px 4px rgb(0 0 0 / 0.55));
  }
  .brass-duck svg {
    width: 100%;
    height: auto;
    overflow: visible;
  }
  .brass-duck__bird {
    transform-origin: 38px 50px;
  }
  .brass-duck:focus-visible {
    outline: 2px solid #f2d27e;
    outline-offset: 4px;
  }
  @media (prefers-reduced-motion: no-preference) {
    .brass-duck:hover .brass-duck__bird,
    .brass-duck:focus-visible .brass-duck__bird {
      animation: waddle 0.5s ease-in-out infinite alternate;
    }
    @keyframes waddle {
      from {
        transform: rotate(-9deg);
      }
      to {
        transform: rotate(9deg) translateY(-1px);
      }
    }
  }
</style>
