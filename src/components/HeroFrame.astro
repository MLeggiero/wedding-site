---
// The photo frame: a fine double-ruled arch holding a photo, with engraved
// plants native to the southeastern US. Three stacked layers share one
// 1000×1300 coordinate system (lib/hero-art.ts): plants behind (each fern and
// leaf its own swaying image), then the photo (HTML, responsive), then the
// ruled frame and the plants in front. The art layers are cached SVG files.
import Photo from './Photo.astro';
import Butterfly from './Butterfly.astro';
import type { Photo as PhotoT } from '../lib/photos';
import type { ButterflyKind } from '../lib/insects';
import { HERO_BOX as VB, HERO_WINDOW as W } from '../lib/hero-art';
import { artUrl, artView, artLayers, type ArtName } from '../lib/art';

interface Props {
  photo: PhotoT;
  alt?: string;
  sizes?: string;
  /** 'hero': the full wreath (home page); 'arch': the lighter frame for inner pages */
  art?: 'hero' | 'arch';
  /** flip the plants left↔right (the arch art only; its file is symmetric) */
  mirror?: boolean;
  /** load the photo first (above the fold) */
  priority?: boolean;
  /** a butterfly or moth resting on the frame's plants, placed in the frame's 1000×1300 units (before any mirroring) */
  butterfly?: { kind: ButterflyKind; at: [number, number]; size?: number; rot?: number };
  class?: string;
}
const { photo, alt, sizes = '(min-width: 64rem) 34rem, 92vw', art = 'hero', mirror = false, priority = art === 'hero', butterfly, class: cls } = Astro.props;
const back = `${art}-back` as ArtName;
const front = `${art}-front` as ArtName;

const pct = (v: number, of: number) => `${((v / of) * 100).toFixed(3)}%`;
const winStyle = [
  `left:${pct(W.left, VB.w)}`,
  `top:${pct(W.top, VB.h)}`,
  `width:${pct(W.right - W.left, VB.w)}`,
  `height:${pct(W.bottom - W.top, VB.h)}`,
  `--ry:${pct(W.r, W.bottom - W.top)}`,
].join(';');
// each art file covers a little more than the drawing; place it to line up
const layerStyle = (name: ArtName) => {
  const [x, y, w, h] = artView(name);
  return `left:${pct(x, VB.w)};top:${pct(y, VB.h)};width:${pct(w, VB.w)};height:${pct(h, VB.h)}`;
};
// the back layer's ferns and leaves sway on their own (a mirrored frame mirrors their places too)
const backLayers = artLayers(back);
const swayStyle = (s: (typeof backLayers.sways)[number]) => {
  const [x, y, w] = s.view;
  return `left:${pct(mirror ? VB.w - x - w : x, VB.w)};top:${pct(y, VB.h)};width:${pct(w, VB.w)};--amp:${s.amp}deg;--dur:${s.dur}s;--delay:${s.delay}s`;
};
---

<figure class:list={['hf', cls, { 'hf--mirror': mirror }]}>
  {
    backLayers.sways.map((s) => (
      <img class="sway hf__sway" src={s.url} alt="" width={s.view[2]} height={s.view[3]} style={swayStyle(s)} decoding="async" loading={priority ? 'eager' : 'lazy'} />
    ))
  }
  {backLayers.base && <img class="hf__layer" src={backLayers.base} alt="" style={layerStyle(back)} decoding="async" loading={priority ? 'eager' : 'lazy'} />}
  <div class="hf__window" style={winStyle}>
    <Photo photo={photo} alt={alt} sizes={sizes} priority={priority} widths={[600, 900, 1200, 1600]} />
  </div>
  <img class="hf__layer" src={artUrl(front)} alt="" style={layerStyle(front)} decoding="async" loading={priority ? 'eager' : 'lazy'} />
  {
    butterfly && (
      <Butterfly
        kind={butterfly.kind}
        view={[0, 0, VB.w, VB.h]}
        at={mirror ? [VB.w - butterfly.at[0], butterfly.at[1]] : butterfly.at}
        size={butterfly.size ?? 150}
        rot={(mirror ? -1 : 1) * (butterfly.rot ?? 0)}
        eager={priority}
      />
    )
  }
</figure>

<style>
  .hf {
    position: relative;
    aspect-ratio: 1000 / 1300;
    margin: 0;
  }
  .hf--mirror :is(.hf__layer, .hf__sway) {
    scale: -1 1;
  }
  .hf__layer {
    position: absolute;
    max-width: none;
    pointer-events: none;
    user-select: none;
  }
  .hf__window {
    position: absolute;
    overflow: hidden;
    border-radius: 50% 50% 0 0 / var(--ry) var(--ry) 0 0;
    background: var(--paper);
  }
  .hf__window :global(picture),
  .hf__window :global(img) {
    width: 100%;
    height: 100%;
  }
  .hf__window :global(img) {
    object-fit: cover;
    object-position: var(--focus);
    filter: var(--photo-tone);
  }
</style>
