---
// A botanical silhouette from the sprite. Position it with `style`
// (e.g. "left:-6%; bottom:-4%; width:38%") inside a positioned parent.
import { BOTANICALS } from '../lib/botanicals';

interface Props {
  kind: 'fern-a' | 'fern-b';
  tone?: 'deep' | 'fern' | 'moss' | 'sand' | 'brass';
  flip?: boolean;
  sway?: boolean;
  class?: string;
  style?: string;
}

const { kind, tone = 'deep', flip = false, sway = true, class: cls, style } = Astro.props;
const b = BOTANICALS[kind];
const [, , w, h] = b.viewBox.split(' ').map(Number);
---

<svg
  class:list={['foliage', `foliage--${b.origin}`, `tone-${tone}`, { 'is-flipped': flip, 'is-swaying': sway }, cls]}
  style={style}
  viewBox={`0 0 ${w} ${h}`}
  aria-hidden="true"
  focusable="false"
>
  <use href={`#${b.id}`} width="100%" height="100%"></use>
</svg>
