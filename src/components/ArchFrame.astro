---
// A photo seen through a Victorian conservatory window: the image is clipped
// to an arch and overlaid with painted glazing bars, a fanlight and a brass
// inner frame. `shape="segmental"` gives a shallow arch for wide photos.
import Photo from './Photo.astro';
import type { Photo as PhotoT } from '../lib/photos';

interface Props {
  photo?: PhotoT;
  /** several photos layered in one window; add `.is-active` to show one */
  stack?: PhotoT[];
  mobile?: PhotoT;
  /** width / height of the window */
  aspect?: number;
  shape?: 'round' | 'segmental';
  /** vertical panes below the spring line */
  panes?: number;
  /** 'full' = fanlight, spring line, mullions and rail; 'frame' = just the
   *  frame (use for small images where bars would cross faces) */
  bars?: 'full' | 'frame';
  sizes: string;
  mobileSizes?: string;
  priority?: boolean;
  alt?: string;
  class?: string;
}

const {
  photo,
  stack,
  mobile,
  aspect = 0.8,
  shape = 'round',
  panes = 4,
  bars: barStyle = 'full',
  sizes,
  mobileSizes,
  priority = false,
  alt,
  class: cls,
} = Astro.props;

const f = (n: number) => +n.toFixed(2);
const H = 100 / aspect; // viewBox height (width is 100)
const ry = shape === 'round' ? 50 : Math.min(50, H * 0.2); // arch rise
const inset = 3.2;
const iry = ry - inset * (ry / 50);

const frame = `M0.8,${f(H)} L0.8,${f(ry)} A49.2,${f(ry - (0.8 * ry) / 50)} 0 0 1 99.2,${f(ry)} L99.2,${f(H)}`;
const inner = `M${inset},${f(H)} L${inset},${f(ry)} A${50 - inset},${f(iry)} 0 0 1 ${100 - inset},${f(ry)} L${100 - inset},${f(H)}`;

let bars = `M${inset},${f(ry)} L${100 - inset},${f(ry)}`; // spring line
for (let i = 1; i < panes; i++) {
  const x = f((100 * i) / panes);
  bars += ` M${x},${f(ry)} L${x},${f(H)}`; // mullions
}
const fan = shape === 'round' ? 6 : 4;
const hub = 9;
const hubRy = hub * (iry / (50 - inset));
for (let k = 1; k < fan; k++) {
  const th = (Math.PI * k) / fan;
  bars += ` M${f(50 + hub * Math.cos(th))},${f(ry - hubRy * Math.sin(th))} L${f(50 + (50 - inset) * Math.cos(th))},${f(ry - iry * Math.sin(th))}`; // fanlight radials
}
bars += ` M${50 - hub},${f(ry)} A${hub},${f(hubRy)} 0 0 1 ${50 + hub},${f(ry)}`; // fanlight hub
const rail = ry + (H - ry) * 0.62;
bars += ` M${inset},${f(rail)} L${100 - inset},${f(rail)}`; // lower rail
---

<figure class:list={['arch', cls]} style={`--arch-aspect:${aspect};--arch-ry:${f((ry / H) * 100)}%`}>
  <div class="arch__glass">
    {
      stack
        ? stack.map((p, i) => (
            <div class:list={['arch__layer', { 'is-active': i === 0 }]} data-layer={i}>
              <Photo photo={p} sizes={sizes} />
            </div>
          ))
        : photo && (
            <Photo photo={photo} mobile={mobile} sizes={sizes} mobileSizes={mobileSizes} priority={priority} alt={alt} />
          )
    }
    <span class="arch__sheen" aria-hidden="true"></span>
  </div>
  <svg class="arch__glazing" viewBox={`0 0 100 ${f(H)}`} preserveAspectRatio="none" aria-hidden="true">
    {barStyle === 'full' && <path class="arch__bars" d={bars} />}
    <path class="arch__inner" d={inner}></path>
    <path class="arch__frame" d={frame}></path>
  </svg>
  <slot />
</figure>

<style>
  .arch {
    position: relative;
    aspect-ratio: var(--arch-aspect);
    isolation: isolate;
    margin: 0;
  }
  .arch__glass {
    position: absolute;
    inset: 0;
    overflow: hidden;
    border-radius: 50% 50% 0 0 / var(--arch-ry) var(--arch-ry) 0 0;
    background: var(--glass-100);
  }
  .arch__glass :global(picture),
  .arch__glass :global(img) {
    width: 100%;
    height: 100%;
  }
  .arch__glass :global(img) {
    object-fit: cover;
    object-position: var(--focus);
  }
  @media (max-width: 47.99rem) {
    .arch__glass :global(img) {
      object-position: var(--focus-m);
    }
  }
  .arch__layer {
    position: absolute;
    inset: 0;
    opacity: 0;
    transition: opacity 650ms var(--ease);
  }
  .arch__layer.is-active {
    opacity: 1;
  }
  .arch__sheen {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      118deg,
      rgb(255 255 255 / 0.22) 0%,
      rgb(255 255 255 / 0) 28%,
      rgb(255 255 255 / 0) 60%,
      rgb(255 255 255 / 0.12) 71%,
      rgb(255 255 255 / 0) 84%
    );
    mix-blend-mode: soft-light;
    pointer-events: none;
  }
  .arch__glazing {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
    pointer-events: none;
  }
  .arch__glazing path {
    fill: none;
    vector-effect: non-scaling-stroke;
  }
  .arch__bars {
    stroke: rgb(246 241 230 / 0.85);
    stroke-width: 1.5;
    filter: drop-shadow(0 0 1px rgb(23 32 26 / 0.4));
  }
  .arch__inner {
    stroke: var(--brass-500);
    stroke-width: 1;
  }
  .arch__frame {
    stroke: var(--green-900);
    stroke-width: 4;
  }
</style>
