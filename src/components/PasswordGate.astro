---
// A courtesy password prompt — NOT security. The content is in the page; the
// prompt only keeps casual visitors out of the details. One correct entry is
// remembered on this device, and ?key=<password> in the URL unlocks directly
// (that's what the invitation QR code uses). Set `detailsPassword` to '' in
// src/config.ts to remove the prompt.
import { site } from '../config';

const pw = site.detailsPassword.trim();
---

{
  pw ? (
    <div class="gate" data-gate>
      <div class="gate__door glass" data-gate-door>
        <p class="kicker">For invited guests</p>
        <h2 class="gate__title">The glasshouse door</h2>
        <p>
          The password is printed on your invitation, which will arrive in {site.invitationsSend}. Enter it once and
          this device will remember it.
        </p>
        <form class="gate__form" data-gate-form>
          <label for="gate-password">Password</label>
          <div class="gate__row">
            <input
              id="gate-password"
              name="password"
              type="text"
              autocomplete="off"
              autocapitalize="none"
              spellcheck="false"
              required
            />
            <button class="btn" type="submit">
              Enter
            </button>
          </div>
          <p class="gate__error" data-gate-error role="alert" hidden>
            That’s not quite it — check your invitation and try again.
          </p>
        </form>
      </div>
      <div class="gate__content" data-gate-content hidden tabindex="-1">
        <slot />
      </div>
      <noscript>
        <style>
          {'[data-gate-content]{display:block!important}[data-gate-door]{display:none!important}'}
        </style>
      </noscript>
    </div>
  ) : (
    <slot />
  )
}

<script is:inline define:vars={{ pw }}>
  (() => {
    if (!pw) return;
    const KEY = 'glasshouse-key';
    const norm = (s) => (s || '').toLowerCase().replace(/\s+/g, '');
    const door = document.querySelector('[data-gate-door]');
    const content = document.querySelector('[data-gate-content]');
    const form = document.querySelector('[data-gate-form]');
    const error = document.querySelector('[data-gate-error]');
    if (!door || !content || !form) return;
    const open = (focus) => {
      door.hidden = true;
      content.hidden = false;
      if (focus) content.focus();
    };
    const remember = () => {
      try {
        localStorage.setItem(KEY, norm(pw));
      } catch {}
    };
    // ?key=... from the invitation QR code
    const url = new URL(location.href);
    const fromUrl = url.searchParams.get('key');
    if (fromUrl !== null) {
      if (norm(fromUrl) === norm(pw)) remember();
      url.searchParams.delete('key');
      history.replaceState(null, '', url.pathname + url.search + url.hash);
    }
    let saved = null;
    try {
      saved = localStorage.getItem(KEY);
    } catch {}
    if (saved === norm(pw)) open(false);
    form.addEventListener('submit', (e) => {
      e.preventDefault();
      if (norm(form.password.value) === norm(pw)) {
        remember();
        open(true);
      } else {
        error.hidden = false;
        door.classList.remove('is-wrong');
        void door.offsetWidth;
        door.classList.add('is-wrong');
      }
    });
  })();
</script>

<style>
  .gate__door {
    max-width: 34rem;
    margin-inline: auto;
    padding: clamp(1.6rem, 4vw, 2.6rem);
    text-align: center;
  }
  .gate__title {
    font-size: var(--step-3);
    margin: 0.3rem 0 0.8rem;
  }
  .gate__form {
    margin-top: 1.4rem;
    text-align: left;
  }
  .gate__form label {
    display: block;
    font-family: var(--font-display);
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    font-size: 0.95rem;
    color: var(--walnut-700);
    margin-bottom: 0.35rem;
  }
  .gate__row {
    display: flex;
    gap: 0.6rem;
  }
  .gate__row input {
    flex: 1;
    min-width: 0;
    min-height: 2.9rem;
    padding: 0.5rem 0.9rem;
    border: 1px solid var(--brass-500);
    border-radius: var(--radius);
    background: rgb(255 255 255 / 0.7);
    color: var(--ink);
    font: inherit;
  }
  .gate__row input:focus-visible {
    outline: 2px solid var(--green-700);
    outline-offset: 1px;
  }
  .gate__error {
    margin-top: 0.7rem;
    color: #8a2f1d;
    font-size: var(--step--1);
  }
  :global(.is-wrong) {
    animation: nudge 360ms var(--ease);
  }
  @keyframes nudge {
    25% {
      translate: -6px 0;
    }
    50% {
      translate: 5px 0;
    }
    75% {
      translate: -3px 0;
    }
  }
  .gate__content:focus {
    outline: none;
  }
</style>
