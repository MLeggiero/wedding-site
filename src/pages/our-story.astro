---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import FloralSection from '../components/FloralSection.astro';
import SectionHeading from '../components/SectionHeading.astro';
import PaperCard from '../components/PaperCard.astro';
import HeroFrame from '../components/HeroFrame.astro';
import { photo } from '../lib/photos';
import { inlineMd } from '../lib/inline-md';
import { withBase } from '../lib/url';

const ch = Object.fromEntries((await getCollection('chapters')).map((c) => [c.id, c.data]));
const notes = [ch['the-question'], ch['how-we-met']];
---

<Base title="Our Story" description="How Ally & Mark got engaged.">
  <FloralSection flora="full" label="Our story" floor={['floor-log', 'floor-morels']}>
    <SectionHeading eyebrow="our story" title="The question" />

    <div class="story container">
      <div class="story__photo">
        <HeroFrame photo={photo('20')} art="arch" mirror priority sizes="(min-width: 60rem) 28rem, 84vw" butterfly={{ kind: 'luna-moth', at: [112, 372], size: 190, rot: 96, tilt: [24, -28] }} />
      </div>
      <div class="story__notes">
        {
          notes.map((n, i) => (
            <PaperCard sprigs={i === 0 ? 'two' : 'none'} width="fill" as="article" class="note">
              <p class="cc-kicker">{n.kicker}</p>
              <h2 class="cc-title">{n.title}</h2>
              <p class="cc-text" set:html={inlineMd(n.body)} />
            </PaperCard>
          ))
        }
        <div class="story__links">
          <a class="btn btn--small" href={withBase('/travel/')}>Travel</a>
          <a class="btn btn--small" href={withBase('/registry/')}>Registry</a>
        </div>
      </div>
    </div>
  </FloralSection>
</Base>

<style>
  .story {
    display: grid;
    gap: clamp(3rem, 6vw, 4.5rem);
    align-items: center;
    max-width: 66rem;
    margin-top: clamp(2.5rem, 6vw, 4rem);
    margin-bottom: clamp(3rem, 8vw, 4.5rem);
  }
  .story__photo {
    width: min(100%, 30rem);
    margin-inline: auto;
  }
  .story__notes {
    display: grid;
    gap: 2.4rem;
    width: min(100%, 30rem);
    margin-inline: auto;
  }
  .story__notes :global(.note .paper-card__body) {
    display: grid;
    gap: 0.35rem;
    padding: 2rem 1.9rem 1.8rem;
    text-align: center;
  }
  .story__links {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 1rem 1.4rem;
  }
  .story__links .btn {
    min-width: 10rem;
  }
  @media (min-width: 60rem) {
    .story {
      grid-template-columns: 30rem 1fr;
    }
  }
</style>
