---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import CozyRoom from '../components/CozyRoom.astro';
import RoomHeading from '../components/RoomHeading.astro';
import GiltCard from '../components/GiltCard.astro';
import HeroFrame from '../components/HeroFrame.astro';
import { photo } from '../lib/photos';
import { inlineMd } from '../lib/inline-md';
import { withBase } from '../lib/url';

const ch = Object.fromEntries((await getCollection('chapters')).map((c) => [c.id, c.data]));
const notes = [ch['the-question'], ch['how-we-met']];
---

<Base title="Our Story" description="How Ally & Mark got engaged.">
  <CozyRoom flora="full" label="Our story">
    <RoomHeading eyebrow="Our story" title="The question" />

    <div class="story container">
      <div class="story__photo">
        <HeroFrame photo={photo('20')} art="arch" mirror priority sizes="(min-width: 60rem) 28rem, 84vw" />
      </div>
      <div class="story__notes">
        {
          notes.map((n, i) => (
            <GiltCard sprigs={i === 0 ? 'two' : 'none'} width="fill" as="article" class="note">
              <p class="cc-kicker">{n.kicker}</p>
              <h2 class="cc-title">{n.title}</h2>
              <p class="cc-text" set:html={inlineMd(n.body)} />
            </GiltCard>
          ))
        }
        <div class="story__links">
          <a class="btn-plate" href={withBase('/travel/')}>Getting to Athens</a>
          <a class="btn-plate" href={withBase('/registry/')}>Gifts & giving</a>
        </div>
      </div>
    </div>
  </CozyRoom>
</Base>

<style>
  .story {
    display: grid;
    gap: clamp(3rem, 6vw, 4.5rem);
    align-items: center;
    max-width: 66rem;
    margin-top: clamp(3.5rem, 7vw, 5rem);
    margin-bottom: clamp(4rem, 9vw, 5.5rem);
  }
  .story__photo {
    width: min(100%, 30rem);
    margin-inline: auto;
  }
  .story__notes {
    display: grid;
    gap: 2.4rem;
    width: min(100%, 30rem);
    margin-inline: auto;
  }
  .story__notes :global(.note .gilt-card__body) {
    display: grid;
    gap: 0.35rem;
    padding: 2rem 1.9rem 1.8rem;
    text-align: center;
  }
  .story__links {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 1.4rem 1.6rem;
    margin-top: 0.4rem;
  }
  @media (min-width: 60rem) {
    .story {
      grid-template-columns: 30rem 1fr;
    }
  }
</style>
