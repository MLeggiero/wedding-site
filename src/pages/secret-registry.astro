---
// The Secret Registry: robots and robot parts, in a 3D room. Unlisted; the only
// way in is the little duck on the Registry page. Gift lists: src/content/robots/.
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Divider from '../components/Divider.astro';
import { site } from '../config';
import { withBase } from '../lib/url';

const robots = (await getCollection('robots')).sort((a, b) => a.id.localeCompare(b.id));
const money = (n: number) => (Number.isInteger(n) ? `$${n.toLocaleString('en-US')}` : `$${n.toFixed(2)}`);
const short: Record<string, string> = { microduck: 'Microduck', 'open-duck-mini': 'Open Duck Mini', 'rebot-arm': 'reBot Arm' };
const checked = (d: Date) => d.toLocaleDateString('en-US', { month: 'long', year: 'numeric', timeZone: 'UTC' });
---

<Base title="Secret Registry" description="Robots and robot parts." bare>
  <div class="ah" data-secret-registry data-endpoint={site.guestEndpoint}>
    <div class="ah__stage">
      <div class="ah__loading" role="status">
        <Divider class="ah__loading-art" />
        <p>Loading…</p>
        <span class="ah__loading-bar" aria-hidden="true"><span></span></span>
      </div>
    </div>

    <header class="ah__head">
      <a class="ah__back" href={withBase('/registry/')}><span aria-hidden="true">←</span> Registry</a>
      <h1 class="ah__title t-script">Secret Registry</h1>
    </header>

    <nav class="ah__picker" aria-label="The robots">
      {
        robots.map((r) => (
          <button type="button" class="ah-pick" data-pick={r.data.scene} aria-pressed="false">
            {short[r.data.scene]}
          </button>
        ))
      }
    </nav>

    <div class="ah__cards">
      {
        robots.map((r) => {
          const d = r.data;
          return (
            <article class="ah-card" data-robot={d.scene} data-name={d.name} aria-labelledby={`ah-${d.scene}`} hidden>
              <button type="button" class="ah-card__close" aria-label={`Close ${d.name}`}>
                ×
              </button>
              <h2 id={`ah-${d.scene}`} tabindex="-1">
                {d.name}
              </h2>
              <p class="ah-card__blurb">{d.blurb}</p>
              {d.scene === 'microduck' && (
                <button type="button" class="btn btn--small ah-card__steer" data-steer>
                  Take the controls
                </button>
              )}
              <ul class="ah-items">
                {d.items.map((it) => (
                  <li class="ah-item" data-item={it.id} data-label={it.label}>
                    <div class="ah-item__main">
                      <a class="ah-item__name" href={it.url} target="_blank" rel="noopener">
                        {it.label}
                        <span class="visually-hidden"> (opens the store)</span>
                      </a>
                      {it.note && <span class="ah-item__note">{it.note}</span>}
                    </div>
                    {it.price && <span class="ah-item__price">{it.qty ? `${it.qty} × ${money(it.price)}` : money(it.price)}</span>}
                    <button type="button" class="ah-claim" hidden>
                      I’m getting this
                    </button>
                    <span class="ah-claimed" hidden>
                      Claimed ✓
                    </span>
                    <form class="ah-claim-form" hidden>
                      <label>
                        <span class="visually-hidden">Your name (optional)</span>
                        <input name="name" maxlength="80" autocomplete="name" placeholder="Your name (optional)" />
                      </label>
                      <input class="guest-form__hp" name="website" tabindex="-1" autocomplete="off" aria-hidden="true" />
                      <button type="submit">Mark it claimed</button>
                      <span class="ah-claim-status" role="status" />
                    </form>
                  </li>
                ))}
              </ul>
              {(site.venmoHandle || site.paypalHandle) && (
                <div class="ah-chip" data-note={d.chipIn.note}>
                  <p class="ah-chip__label">Chip in</p>
                  <div class="ah-chip__amounts" role="group" aria-label="Amount">
                    {d.chipIn.suggested.map((a) => (
                      <button type="button" data-amount={a} aria-pressed="false">
                        {money(a)}
                      </button>
                    ))}
                  </div>
                  <div class="ah-chip__pay">
                    {site.venmoHandle && (
                      <a class="ah-chip__btn" data-venmo={site.venmoHandle} href={`https://venmo.com/${site.venmoHandle}`} target="_blank" rel="noopener">
                        Venmo
                      </a>
                    )}
                    {site.paypalHandle && (
                      <a class="ah-chip__btn" data-paypal={site.paypalHandle} href={`https://paypal.me/${site.paypalHandle}`} target="_blank" rel="noopener">
                        PayPal
                      </a>
                    )}
                  </div>
                </div>
              )}
              <p class="ah-card__credit">
                {d.credit}{' '}
                {d.model && (
                  <>
                    3D model: <a href={d.model.source} target="_blank" rel="noopener">{d.model.by}</a>,{' '}
                    <a href={d.model.licenseUrl} target="_blank" rel="noopener">{d.model.license}</a>, simplified for the web.{' '}
                  </>
                )}
                <a href={d.project.url} target="_blank" rel="noopener">{d.project.label}</a> · Prices checked {checked(d.checked)}.
              </p>
            </article>
          );
        })
      }
    </div>

    <div class="ah__steer" hidden>
      <div class="ah-pad" aria-hidden="true"><span class="ah-pad__knob"></span></div>
      <p class="ah__steer-hint">
        <span class="ah__steer-keys">Arrow keys or WASD to walk</span>
        <span class="ah__steer-touch">Drag the pad to walk</span>
      </p>
      <button type="button" class="btn btn--small ah__steer-done">Done</button>
    </div>
  </div>
  <noscript><style>.ah-card { display: block !important; } .ah__loading, .ah__picker { display: none !important; }</style></noscript>
</Base>

<script>
  import '../scripts/secret-registry/main';
</script>

<style>
  :global(body) {
    background: var(--paper);
  }
  .ah {
    position: relative;
    height: 100svh;
    min-height: 32rem;
    overflow: hidden;
    color: var(--text);
    background: var(--paper);
  }
  .ah__stage {
    position: absolute;
    inset: 0;
  }
  .ah__stage :global(canvas) {
    display: block;
    width: 100%;
    height: 100%;
    touch-action: none;
  }

  /* a ruled paper panel, shared by the heading, the cards and the controls */
  .ah__head,
  .ah-card,
  .ah__picker,
  .ah__steer-hint {
    background: var(--paper-2);
    border: 1px solid var(--ink);
    box-shadow:
      inset 0 0 0 4px var(--paper-2),
      inset 0 0 0 5px var(--rule);
  }

  /* loading */
  .ah__loading {
    position: absolute;
    inset: 0;
    z-index: 5;
    display: grid;
    place-content: center;
    justify-items: center;
    gap: 0.6rem;
    background: var(--paper);
    font-family: var(--font-caps);
    font-weight: 600;
    font-size: 0.9rem;
    letter-spacing: 0.26em;
    text-transform: uppercase;
    color: var(--heading);
    transition: opacity 600ms ease;
  }
  .ah__loading :global(.ah__loading-art) {
    width: 12rem;
  }
  .ah__loading.is-done {
    opacity: 0;
    pointer-events: none;
  }
  .ah__loading-bar {
    width: 10rem;
    height: 1px;
    background: var(--rule);
    overflow: hidden;
  }
  .ah__loading-bar span {
    display: block;
    width: 0;
    height: 100%;
    background: var(--ink);
    transition: width 200ms ease;
  }

  /* heading */
  .ah__head {
    position: absolute;
    z-index: 3;
    top: clamp(0.75rem, 2vw, 1.4rem);
    left: clamp(0.75rem, 2vw, 1.4rem);
    display: grid;
    justify-items: start;
    max-width: calc(100% - 1.5rem);
    padding: 0.7rem 1.4rem 0.5rem 1.2rem;
  }
  .ah__back {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    min-height: 2.75rem;
    font-family: var(--font-caps);
    font-weight: 600;
    font-size: 0.84rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--heading);
    text-decoration: none;
  }
  .ah__back:hover {
    color: var(--text);
    text-decoration: underline;
    text-decoration-color: var(--rule);
    text-underline-offset: 0.3em;
  }
  .ah__title {
    margin-top: -0.35rem;
    padding: 0 0.1em;
    font-size: clamp(2.9rem, 2.3rem + 2.2vw, 4.2rem);
    line-height: 1.12;
  }

  /* robot picker */
  .ah__picker {
    position: absolute;
    z-index: 4;
    left: 50%;
    bottom: max(0.9rem, env(safe-area-inset-bottom));
    translate: -50% 0;
    display: flex;
    gap: 0.5rem;
    padding: 0.55rem;
  }
  .ah-pick {
    min-height: 2.9rem;
    padding: 0.4rem 1rem 0.45rem;
    border: 1px solid var(--ink);
    border-radius: 2px;
    background: transparent;
    color: var(--heading);
    font-family: var(--font-caps);
    font-weight: 600;
    font-size: 0.86rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    white-space: nowrap;
    cursor: pointer;
  }
  .ah-pick:hover {
    background: var(--wash);
  }
  .ah-pick[aria-pressed='true'] {
    border-color: var(--heading);
    background: var(--heading);
    color: var(--paper-2);
  }
  .ah-pick:focus-visible,
  .ah-card :focus-visible,
  .ah__steer :focus-visible,
  .ah__head :focus-visible {
    outline: 2px solid var(--heading);
    outline-offset: 3px;
  }

  /* gift cards */
  .ah-card {
    position: absolute;
    z-index: 4;
    right: clamp(0.75rem, 2vw, 1.5rem);
    top: clamp(0.75rem, 2vw, 1.5rem);
    max-height: calc(100% - 7rem);
    width: min(27rem, 42vw);
    overflow-y: auto;
    overscroll-behavior: contain;
    padding: 1.6rem 1.6rem 1.4rem;
    font-size: 1.1rem;
  }
  .ah-card h2 {
    padding-right: 2rem;
    font-family: var(--font-caps);
    font-weight: 600;
    font-size: 1.75rem;
    line-height: 1.1;
    color: var(--heading);
    outline: none;
  }
  .ah-card__blurb {
    margin-top: 0.35rem;
    font-style: italic;
    color: var(--soft);
  }
  .ah-card__close {
    position: absolute;
    top: 0.5rem;
    right: 0.5rem;
    width: 2.75rem;
    height: 2.75rem;
    border: 0;
    border-radius: 50%;
    background: transparent;
    color: var(--heading);
    font-size: 1.8rem;
    line-height: 1;
    cursor: pointer;
  }
  .ah-card__close:hover {
    background: var(--wash);
  }
  .ah-card__steer {
    margin-top: 1rem;
  }
  .ah-items {
    list-style: none;
    margin: 1.1rem 0 0;
    padding: 0;
    border-top: 1px solid var(--rule);
  }
  .ah-item {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 0.15rem 0.8rem;
    align-items: baseline;
    padding: 0.7rem 0;
    border-bottom: 1px solid var(--rule);
  }
  .ah-item__name {
    font-family: var(--font-caps);
    font-weight: 700;
    font-size: 1.2rem;
    color: var(--heading);
  }
  .ah-item__name:hover {
    color: var(--text);
  }
  .ah-item__note {
    display: block;
    font-size: 1rem;
    font-style: italic;
    line-height: 1.4;
    color: var(--soft);
  }
  .ah-item__price {
    font-family: var(--font-caps);
    font-weight: 600;
    font-size: 1.15rem;
    font-variant-numeric: lining-nums;
    color: var(--heading);
    white-space: nowrap;
  }
  .ah-claim,
  .ah-claim-form button,
  .ah-chip button,
  .ah-chip__btn {
    min-height: 2.6rem;
    padding: 0.3rem 0.9rem 0.35rem;
    border: 1px solid var(--ink);
    border-radius: 2px;
    background: transparent;
    color: var(--heading);
    font-family: var(--font-caps);
    font-weight: 600;
    font-size: 0.8rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    cursor: pointer;
  }
  .ah-claim {
    grid-column: 1 / -1;
    justify-self: start;
    margin-top: 0.35rem;
  }
  .ah-claim:hover,
  .ah-chip button:hover,
  .ah-claim-form button:hover {
    background: var(--wash);
  }
  .ah-claimed {
    grid-column: 1 / -1;
    font-family: var(--font-caps);
    font-weight: 600;
    font-size: 0.82rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--heading);
  }
  .ah-item.is-claimed .ah-item__name {
    color: var(--soft);
  }
  .ah-claim-form {
    grid-column: 1 / -1;
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-top: 0.4rem;
  }
  .ah-claim-form input:not(.guest-form__hp) {
    flex: 1 1 10rem;
    min-height: 2.6rem;
    padding: 0.3rem 0.6rem;
    border: 1px solid var(--ink);
    border-radius: 2px;
    background: var(--paper-2);
    color: var(--text);
    font: inherit;
    font-size: 1rem;
  }
  .ah-claim-status {
    flex-basis: 100%;
    font-style: italic;
    color: var(--heading);
  }
  .ah-chip {
    margin-top: 1.1rem;
  }
  .ah-chip__label {
    font-family: var(--font-caps);
    font-weight: 600;
    font-size: 0.86rem;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: var(--heading);
  }
  .ah-chip__amounts,
  .ah-chip__pay {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-top: 0.45rem;
  }
  .ah-chip button[aria-pressed='true'],
  .ah-chip__btn {
    border-color: var(--heading);
    background: var(--heading);
    color: var(--paper-2);
  }
  .ah-chip__btn {
    display: inline-flex;
    align-items: center;
    text-decoration: none;
  }
  .ah-chip__btn:hover {
    background: var(--text);
    color: var(--paper-2);
  }
  .ah-card__credit {
    margin-top: 1.1rem;
    font-size: 0.95rem;
    font-style: italic;
    line-height: 1.45;
    color: var(--soft);
  }
  .ah-card__credit a {
    color: var(--heading);
  }

  /* steering */
  .ah__steer {
    position: absolute;
    z-index: 4;
    inset: auto 0 max(0.9rem, env(safe-area-inset-bottom)) 0;
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1rem;
    padding: 0 clamp(1rem, 3vw, 2rem);
    pointer-events: none;
  }
  .ah__steer > * {
    pointer-events: auto;
  }
  .ah__steer-hint {
    margin-inline: auto;
    padding: 0.55rem 1.2rem 0.6rem;
    text-align: center;
    font-family: var(--font-caps);
    font-weight: 600;
    font-size: 0.84rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--heading);
  }
  .ah-pad {
    position: relative;
    flex: none;
    width: 8.5rem;
    height: 8.5rem;
    border: 1px solid var(--ink);
    border-radius: 50%;
    background: rgb(247 245 239 / 0.9);
    box-shadow:
      inset 0 0 0 5px rgb(247 245 239 / 0.9),
      inset 0 0 0 6px var(--rule);
    touch-action: none;
  }
  .ah-pad__knob {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 3.4rem;
    height: 3.4rem;
    margin: -1.7rem 0 0 -1.7rem;
    border-radius: 50%;
    background: var(--heading);
    box-shadow:
      inset 0 0 0 3px var(--heading),
      inset 0 0 0 4px var(--paper-2);
  }
  .ah__steer-touch {
    display: none;
  }
  @media (pointer: coarse) {
    .ah__steer-keys {
      display: none;
    }
    .ah__steer-touch {
      display: inline;
    }
  }
  @media (pointer: fine) {
    .ah-pad {
      display: none;
    }
  }
  .ah.is-steering .ah__picker,
  .ah.is-steering .ah__head {
    display: none;
  }

  /* phones: the card becomes a sheet above the picker */
  @media (max-width: 47.99rem) {
    .ah-card {
      left: 0.6rem;
      right: 0.6rem;
      top: auto;
      bottom: 5.2rem;
      width: auto;
      max-height: 60svh;
      padding: 1.3rem 1.2rem 1.1rem;
    }
    .ah__head {
      padding: 0.45rem 1.1rem 0.35rem 0.95rem;
    }
    .ah__title {
      font-size: 2.7rem;
    }
    .ah__picker {
      gap: 0.3rem;
      padding: 0.4rem;
      width: max-content;
      max-width: calc(100% - 1.2rem);
    }
    .ah-pick {
      padding-inline: 0.55rem;
      font-size: 0.74rem;
      letter-spacing: 0.1em;
    }
  }

  /* without WebGL: the cards as a simple list */
  .ah--list {
    height: auto;
    min-height: 100svh;
    overflow: visible;
  }
  .ah--list .ah__stage,
  .ah--list .ah__picker,
  .ah--list .ah-card__close,
  .ah--list .ah-card__steer {
    display: none;
  }
  .ah--list .ah__head {
    position: relative;
    margin: 1rem clamp(1rem, 4vw, 2rem) 0;
    left: auto;
    top: auto;
    width: fit-content;
  }
  .ah--list .ah__cards {
    display: grid;
    gap: 2.2rem;
    padding: 1.5rem clamp(1rem, 4vw, 2rem) 3rem;
    max-width: 32rem;
  }
  .ah--list .ah-card {
    position: relative;
    inset: auto;
    display: block !important;
    width: auto;
    max-height: none;
  }
</style>
