---
// "N days until we're married under glass" — rendered at build time and
// refreshed in the browser so it's always today's number.
import { site } from '../config';
import PlantTag from './PlantTag.astro';

interface Props {
  /** 'tag' = brass plant tag (default); 'plain' = just the text, for custom frames */
  variant?: 'tag' | 'plain';
}
const { variant = 'tag' } = Astro.props;

function daysUntil(now: Date): number {
  const today = new Intl.DateTimeFormat('en-CA', {
    timeZone: 'America/New_York',
    year: 'numeric',
    month: '2-digit',
    day: '2-digit',
  }).format(now);
  return Math.round((Date.parse(`${site.date}T00:00:00Z`) - Date.parse(`${today}T00:00:00Z`)) / 86_400_000);
}
const days = daysUntil(new Date());
---

{
  variant === 'plain' ? (
    <span class="countdown" data-countdown data-date={site.date}>
      {days > 1 ? (
        <>
          <strong>{days}</strong> days until “I do”
        </>
      ) : days === 1 ? (
        'Tomorrow, we say “I do”'
      ) : days === 0 ? (
        'Today, we say “I do”'
      ) : (
        'Married April 24, 2027'
      )}
    </span>
  ) : (
    <PlantTag class="countdown">
      <span data-countdown data-date={site.date}>
        {days > 1 ? (
          <>
            <strong>{days}</strong> days until “I do”
          </>
        ) : days === 1 ? (
          'Tomorrow, we say “I do”'
        ) : days === 0 ? (
          'Today, we say “I do”'
        ) : (
          'Married April 24, 2027'
        )}
      </span>
    </PlantTag>
  )
}

<script>
  for (const el of document.querySelectorAll<HTMLElement>('[data-countdown]')) {
    const target = el.dataset.date!;
    const today = new Intl.DateTimeFormat('en-CA', {
      timeZone: 'America/New_York',
      year: 'numeric',
      month: '2-digit',
      day: '2-digit',
    }).format(new Date());
    const days = Math.round((Date.parse(`${target}T00:00:00Z`) - Date.parse(`${today}T00:00:00Z`)) / 86_400_000);
    if (days > 1) el.innerHTML = `<strong>${days}</strong> days until “I do”`;
    else if (days === 1) el.textContent = 'Tomorrow, we say “I do”';
    else if (days === 0) el.textContent = 'Today, we say “I do”';
    else el.textContent = 'Married April 24, 2027';
  }
</script>

<style>
  .countdown :global(strong) {
    font-size: 1.25em;
    font-weight: 700;
    margin-right: 0.1em;
  }
</style>
